t="26" rx="4" class="m c"><title>пара {6, 8}</title></rect><rect x="192" y="282" width="26" height="26" rx="4" class="m b"><title>пара {6, 9}</title></rect><rect x="192" y="312" width="26" height="26" rx="4" class="m b c"><title>пара {6, 10}</title></rect><rect x="192" y="342" width="26" height="26" rx="4" class="m b c"><title>пара {6, 11}</title></rect><rect x="192" y="372" width="26" height="26" rx="4" class="u"><title>пара {6, 12}</title></rect><rect x="192" y="402" width="26" height="26" rx="4" class="u"><title>пара {6, 13}</title></rect><rect x="192" y="432" width="26" height="26" rx="4" class="u"><title>пара {6, 14}</title></rect><rect x="192" y="462" width="26" height="26" rx="4" class="u"><title>пара {6, 15}</title></rect><rect x="222" y="252" width="26" height="26" rx="4" class="m"><title>пара {7, 8}</title></rect><rect x="222" y="282" width="26" height="26" rx="4" class="m b c"><title>пара {7, 9}</title></rect><rect x="222" y="312" width="26" height="26" rx="4" class="m b"><title>пара {7, 10}</title></rect><rect x="222" y="342" width="26" height="26" rx="4" class="m b"><title>пара {7, 11}</title></rect><rect x="222" y="372" width="26" height="26" rx="4" class="u"><title>пара {7, 12}</title></rect><rect x="222" y="402" width="26" height="26" rx="4" class="u"><title>пара {7, 13}</title></rect><rect x="222" y="432" width="26" height="26" rx="4" class="u"><title>пара {7, 14}</title></rect><rect x="222" y="462" width="26" height="26" rx="4" class="u"><title>пара {7, 15}</title></rect><rect x="252" y="282" width="26" height="26" rx="4" class="m b c"><title>пара {8, 9}</title></rect><rect x="252" y="312" width="26" height="26" rx="4" class="m b"><title>пара {8, 10}</title></rect><rect x="252" y="342" width="26" height="26" rx="4" class="m b"><title>пара {8, 11}</title></rect><rect x="252" y="372" width="26" height="26" rx="4" class="u"><title>пара {8, 12}</title></rect><rect x="252" y="402" width="26" height="26" rx="4" class="u"><title>пара {8, 13}</title></rect><rect x="252" y="432" width="26" height="26" rx="4" class="u"><title>пара {8, 14}</title></rect><rect x="252" y="462" width="26" height="26" rx="4" class="u"><title>пара {8, 15}</title></rect><rect x="282" y="312" width="26" height="26" rx="4" class="m c"><title>пара {9, 10}</title></rect><rect x="282" y="342" width="26" height="26" rx="4" class="m c"><title>пара {9, 11}</title></rect><rect x="282" y="372" width="26" height="26" rx="4" class="u"><title>пара {9, 12}</title></rect><rect x="282" y="402" width="26" height="26" rx="4" class="u"><title>пара {9, 13}</title></rect><rect x="282" y="432" width="26" height="26" rx="4" class="u"><title>пара {9, 14}</title></rect><rect x="282" y="462" width="26" height="26" rx="4" class="u"><title>пара {9, 15}</title></rect><rect x="312" y="342" width="26" height="26" rx="4" class="m"><title>пара {10, 11}</title></rect><rect x="312" y="372" width="26" height="26" rx="4" class="u"><title>пара {10, 12}</title></rect><rect x="312" y="402" width="26" height="26" rx="4" class="u"><title>пара {10, 13}</title></rect><rect x="312" y="432" width="26" height="26" rx="4" class="u"><title>пара {10, 14}</title></rect><rect x="312" y="462" width="26" height="26" rx="4" class="u"><title>пара {10, 15}</title></rect><rect x="342" y="372" width="26" height="26" rx="4" class="u"><title>пара {11, 12}</title></rect><rect x="342" y="402" width="26" height="26" rx="4" class="u"><title>пара {11, 13}</title></rect><rect x="342" y="432" width="26" height="26" rx="4" class="u"><title>пара {11, 14}</title></rect><rect x="342" y="462" width="26" height="26" rx="4" class="u"><title>пара {11, 15}</title></rect><rect x="372" y="402" width="26" height="26" rx="4" class="m c"><title>пара {12, 13}</title></rect><rect x="372" y="432" width="26" height="26" rx="4" class="m b"><title>пара {12, 14}</title></rect><rect x="372" y="462" width="26" height="26" rx="4" class="m b c"><title>пара {12, 15}</title></rect><rect x="402" y="432" width="26" height="26" rx="4" class="m b c"><title>пара {13, 14}</title></rect><rect x="402" y="462" width="26" height="26" rx="4" class="m b"><title>пара {13, 15}</title></rect><rect x="432" y="462" width="26" height="26" rx="4" class="m c"><title>пара {14, 15}</title></rect><rect x="40" y="40" width="120" height="120" class="pm-grp"/><rect x="160" y="160" width="210" height="210" class="pm-grp"/><rect x="370" y="370" width="120" height="120" class="pm-grp"/></svg><div class="pm-side"><div class="pm-big"><span class="pm-n">0</span> из <b>33</b></div><div class="pm-u">U = <b class="pm-uv">0</b></div><ul class="pm-leg"><li><i class="m"></i>слита возрастной группой κ, не разделена</li><li><i class="s"></i>разделена уточнением</li><li><i class="u"></i>разные возрастные группы — не слита</li></ul><p class="pm-txt" aria-live="polite"></p></div></div></div><p class="ord-note">Неразделёнными остаются три пары взрослых, {5, 6}, {7, 8} и {10, 11}: одна ветвь, один город. Квадратами обведены возрастные группы: дети № 1–4, взрослые № 5–11, старшее поколение № 12–15.</p><div class="cap2"><div class="c2 c2-w"><b>Что здесь.</b> Матрица 105 пар для 15 человек на снимке: какие пары сливает возраст и какие разделяют уточнения.</div><div class="c2 c2-t"><b>К тексту.</b> Абзац: без уточнений N = 0; ветвь семьи разделяет 20 из 33 пар, оба уточнения — 30 из 33.</div><div class="c2 c2-h"><b>Как читать.</b> Клетка — пара людей; цвет показывает, слита ли пара и каким уточнением разделена.</div></div><figcaption class="viz-foot"><span class="viz-src"><b class="fig-n">Рис. 92.</b> Матрица 105 пар: что сливает возраст и что разделяют уточнения. Построено по тексту главы, §4.4.2</span><a class="viz-back" href="#4-4-2-semeinaya-fotografiya-kak-schitaetsya-inde">к тексту §4.4.2 ↑</a></figcaption></figure><p>Расчёт выполнен строго по (1.29)–(1.32), короткой программой на Python. Числа легко проверить вручную. В группе из k человек k(k−1)/2 пар. Разделённые пары — те, чьи члены получили разные метки уточнения.</p><p>Учебный расчёт U для условной фотографии из 15 человек (единичные веса)</p><div data-anchor="1" class="table-wrap"><table><tr class="th-row"><th><p><strong>Шаг и семейство A</strong></p></th><th><p><strong>Разделено пар: дети / взрослые / старшие</strong></p></th><th><p><strong>N из D</strong></p></th><th><p><strong>Uκ,A,R</strong></p></th></tr><tr><td><p>0. A = ∅</p></td><td><p>0 из 6 / 0 из 21 / 0 из 6</p></td><td><p>0 из 33</p></td><td><p>0</p></td></tr><tr><td><p>1. A = {κ′1}: возраст; ветвь</p></td><td><p>4 / 12 / 4</p></td><td><p>20 из 33</p></td><td><p>20/33 ≈ 0,61</p></td></tr><tr><td><p>1′. A = {κ′2}: возраст; место</p></td><td><p>4 / 12 / 4</p></td><td><p>20 из 33</p></td><td><p>20/33 ≈ 0,61</p></td></tr><tr><td><p>2. A = {κ′1, κ′2}</p></td><td><p>6 / 18 / 6</p></td><td><p>30 из 33</p></td><td><p>10/11 ≈ 0,91</p></td></tr><tr><td><p>Граничный случай: κ — индивидуальная подпись</p></td><td><p>слитых пар нет</p></td><td><p>D = 0</p></td><td><p>NA</p></td></tr></table></div><p class="figrefs-after" data-x="1"><a class="figref" href="#viz-ucalc" title="перейти к рисунку">Рис. 93 ↓</a><a class="figref" href="#viz-ubars" title="перейти к рисунку">Рис. 94 ↓</a></p><figure class="viz wide reveal " id="viz-ucalc" data-x="1" aria-label="Калькулятор индекса U = N / D"><div class="viz-kicker">Инфографика · §4.4.2</div><h3 class="viz-title">Калькулятор индекса U = N / D</h3><p class="viz-lead">Индекс — их отношение: Uκ,A,R(Ω) := Nκ,A,R / Dκ,R при Dκ,R &gt; 0 и NA при Dκ,R = 0 (1.32). Числа в примерах — из текста; ползунки — для собственной пробы.</p><div class="ucalc" data-viz="ucalc">
<div class="u-presets" role="group" aria-label="Примеры из текста">
 <button class="on" data-n="4" data-d="6" data-m="metro">Метро: 4 выхода Центральной</button>
 <button data-n="0" data-d="33">Фото: A = ∅</button>
 <button data-n="20" data-d="33">Фото: возраст; ветвь</button>
 <button data-n="20" data-d="33">Фото: возраст; место</button>
 <button data-n="30" data-d="33">Фото: оба уточнения</button>
 <button data-n="0" data-d="0">Подпись: слитых пар нет</button>
</div>
<div class="u-main">
 <div class="u-ctrl">
  <label>D — слитые пары (знаменатель) <output class="u-dv">6</output><input type="range" class="u-d" min="0" max="60" value="6"></label>
  <label>N — разделённые уточнением (числитель) <output class="u-nv">4</output><input type="range" class="u-n" min="0" max="6" value="4"></label>
  <div class="u-res"><div class="u-frac"><span class="u-num">4</span><span class="u-den">6</span></div><div class="u-eq">U = <b class="u-val">0,67</b></div></div>
  <p class="u-explain" aria-live="polite"></p>
 </div>
 <div class="u-vis"><svg class="u-station" viewBox="0 0 300 220" aria-label="Четыре выхода станции: два с лифтом, два без"></svg><div class="u-grid" aria-hidden="true"></div></div>
</div>
<p class="u-motto">U — памятка о процедуре, не мера мира</p></div><div class="cap2"><div class="c2 c2-w"><b>Что здесь.</b> Калькулятор индекса U = N / D для учебного снимка.</div><div class="c2 c2-t"><b>К тексту.</b> Таблица выше даёт шаги расчёта; калькулятор показывает, как меняется U при выборе семейства уточнений A.</div><div class="c2 c2-h"><b>Как читать.</b> N — разделённые пары, D — слитые пары; U = N / D.</div></div><figcaption class="viz-foot"><span class="viz-src"><b class="fig-n">Рис. 93.</b> Калькулятор индекса U = N / D. Построено по тексту главы, §4.4.2</span><a class="viz-back" href="#4-4-2-semeinaya-fotografiya-kak-schitaetsya-inde">к тексту §4.4.2 ↑</a></figcaption></figure><figure class="viz wide reveal " id="viz-ubars" data-x="1" aria-label="Индекс U в примерах главы"><div class="viz-kicker">График · §4.4.2</div><h3 class="viz-title">Индекс U в примерах главы</h3><p class="viz-lead">Все значения — из таблицы расчёта и из примера со схемой метро.</p><div class="ubars"><div class="ub"><span class="ub-l">A = ∅</span><span class="ub-t"><span class="ub-f" style="--v:0.0000"></span></span><span class="ub-v">0</span><span class="ub-g">дети 0 из 6 · взрослые 0 из 21 · старшие 0 из 6</span></div><div class="ub"><span class="ub-l">κ′1: возраст; ветвь</span><span class="ub-t"><span class="ub-f" style="--v:0.6061"></span></span><span class="ub-v">20/33 ≈ 0,61</span><span class="ub-g">дети 4 из 6 · взрослые 12 из 21 · старшие 4 из 6</span></div><div class="ub"><span class="ub-l">κ′2: возраст; место</span><span class="ub-t"><span class="ub-f" style="--v:0.6061"></span></span><span class="ub-v">20/33 ≈ 0,61</span><span class="ub-g">дети 4 из 6 · взрослые 12 из 21 · старшие 4 из 6</span></div><div class="ub"><span class="ub-l">{κ′1, κ′2}</span><span class="ub-t"><span class="ub-f" style="--v:0.9091"></span></span><span class="ub-v">10/11 ≈ 0,91</span><span class="ub-g">дети 6 из 6 · взрослые 18 из 21 · старшие 6 из 6</span></div><div class="ub metro"><span class="ub-l">метро: план с лифтами</span><span class="ub-t"><span class="ub-f" style="--v:0.6667"></span></span><span class="ub-v">4/6 = 2/3</span><span class="ub-g">Центральная: 4 выхода, D = 6, N = 4</span></div></div><div class="ub-na"><b>NA</b> — NA при Dκ,R = 0</div><p class="ord-note">Граничный случай из таблицы: κ — индивидуальная подпись, слитых пар нет, D = 0, поэтому U не определён (NA). Число относится к описи; личное прочтение снимка из §1.4 потребовало бы своей задачи и своих весов.</p><div class="cap2"><div class="c2 c2-w"><b>Что здесь.</b> Столбики: значения U в примерах главы.</div><div class="c2 c2-t"><b>К тексту.</b> Таблица выше даёт U = 0, 20/33 ≈ 0,61 и 10/11 ≈ 0,91; столбики сравнивают эти доли.</div></div><figcaption class="viz-foot"><span class="viz-src"><b class="fig-n">Рис. 94.</b> Индекс U в примерах главы. Построено по тексту главы, §4.4.2</span><a class="viz-back" href="#4-4-2-semeinaya-fotografiya-kak-schitaetsya-inde">к тексту §4.4.2 ↑</a></figcaption></figure><p>Чтение расчёта. U = 10/11 говорит ровно одно: заранее разрешённое семейство из двух уточнений способно разделить 30 из 33 пар, слитых возрастной группой, при единичных весах и задаче описи. Число относится к описи; личное прочтение снимка из §1.4 потребовало бы своей задачи и своих весов. Три оставшиеся пары точно показывают, где кончается выбранное семейство уточнений, и подсказывают, какое различение искать дальше; уточнение, найденное после знакомства с результатом, оформляется новым паспортом. Осталось провести те же записи через случай, где от различения зависит помощь людям.</p><aside class="pull reveal" data-x="1" aria-hidden="true"><span class="pull-mark">“</span><p>Три оставшиеся пары точно показывают, где кончается выбранное семейство уточнений</p><span class="pull-src">§4.4.2</span></aside><aside class="sumcard reveal" id="sum-32" data-x="1" aria-label="Главное в подразделе"><div class="sum-k"><span class="sum-ic">★</span>Главное в подразделе · §4.4.2</div><ul><li>Такой ноль говорит о бедности A, а не о том, что κ достаточно.</li><li>U = 10/11 говорит ровно одно: заранее разрешённое семейство из двух уточнений способно разделить 30 из 33 пар, слитых возрастной группой, при единичных весах и задаче описи.</li></ul><div class="sum-f"><!--32-->Карточка-резюме: фразы из текста подраздела, без новых утверждений. <a href="#4-4-2-semeinaya-fotografiya-kak-schitaetsya-inde">к началу подраздела ↑</a></div></aside><h4 id="4-4-3-odin-sluchai-ot-nachala-do-kontsa-sotsialn">4.4.3. Один случай от начала до конца: социальная служба<a class="anchor" href="#4-4-3-odin-sluchai-ot-nachala-do-kontsa-sotsialn" aria-label="Ссылка на раздел">#</a></h4><p>Теперь проведём через записи одну ситуацию целиком. Каждый символ появится там, где без него ошибку уже не видно. Это условная служба из §1.5. Модель M прогнозирует, сколько раз семья обратится в следующем году (задача T). Руководство читает ранжирование как меру нужды (T′). Район N, годы 2022–2025. Следим за одной семьёй: нужда высокая, доступ низкий, живёт далеко от центра и плохо говорит на языке службы.</p><p>Нужда принимает форму. В службу приходит не нужда, а звонок, визит, заявление. Болезнь, долги и одиночество служба видит через число обращений. По этому критерию, κ, семья становится строкой с числом. Это вторая запись, установление формы: App(Fκ) :⇔ Fκ определена как различимая по κ. Совпадает ли форма с нуждой, решает отдельная проверка (паспорт 4A.3).</p><p data-anchor="1">Статистическая физика давно пользуется тем же приёмом. Положения и скорости всех молекул газа составляют его микросостояние, и одному значению температуры отвечает огромное множество таких состояний. Огрубление здесь рабочий инструмент, и в своих задачах он точен.<span class="figrefs" data-x="1"> <a class="figref" href="#viz-gas" title="перейти к рисунку">Рис. 95 ↓</a></span></p><figure class="viz wide reveal " id="viz-gas" data-x="1" aria-label="Газ и температура: много микросостояний → одно число"><div class="viz-kicker">Инфографика · §4.4.3</div><h3 class="viz-title">Газ и температура: много микросостояний → одно число</h3><p class="viz-lead">одному значению температуры отвечает огромное множество таких состояний.</p><div class="gas" data-viz="gas"><div class="gas-box"><canvas class="gas-cv" width="520" height="300" aria-label="Анимированная схема: множество частиц в сосуде"></canvas><div class="gas-split" hidden></div><div class="gas-lr" hidden><span class="gl-l"></span><span class="gl-r"></span></div></div>
<div class="gas-arrow">огрубление →</div>
<div class="gas-t"><div class="thermo"><div class="thermo-fill"></div></div><div class="gas-tl"><b>одно число</b><span>температура</span></div></div></div>
<div class="gas-btns"><button class="gas-ref" aria-pressed="false">Показать уточнение: молекулы в левой половине</button><button class="gas-pause" aria-pressed="false">Пауза</button></div>
<p class="gas-note">Уточнение, например число молекул в левой половине сосуда при той же температуре, разделяет часть этих слияний.</p><p class="gas-note sm">Схема, а не модель газа: частицы нарисованы для наглядности.</p><div class="cap2"><div class="c2 c2-w"><b>Что здесь.</b> Газ и температура: много микросостояний → одно число.</div><div class="c2 c2-t"><b>К тексту.</b> Абзац: одному значению температуры отвечает огромное множество микросостояний; огрубление здесь — рабочий инструмент.</div></div><figcaption class="viz-foot"><span class="viz-src"><b class="fig-n">Рис. 95.</b> Газ и температура: много микросостояний → одно число. Построено по тексту главы, §4.4.3</span><a class="viz-back" href="#4-4-3-odin-sluchai-ot-nachala-do-kontsa-sotsialn">к тексту §4.4.3 ↑</a></figcaption></figure><p data-anchor="1">Список делит район. Число обращений огрубляет семью, как температура огрубляет газ, но задача сменилась: спрашивают о нужде. Руководство берёт верхние строки. Выделенное, A, — семьи в списке. Остаток, ¬κA, — семьи того же района и тех же лет ниже черты, в том числе нужда, которая не дошла до обращений. Граница, Γκ, на бумаге — черта списка. По смыслу она проходит там, где нужда перестаёт становиться обращениями: языковой барьер, дальняя дорога, недоверие, нет телефона. За этим барьером алгоритм слепнет. Отношение, Rκ: службу и семью связывает строка списка. Та же запись, что хранила ночную улицу: <span class="dhat">Δ<span class="cmb">̂</span></span>κ ⇒ (A, ¬κA, Γκ, Rκ). Там граница отделяла звук от тишины, здесь — услышанную нужду от неуслышанной (паспорта 4A.7, 4A.8).<span class="figrefs" data-x="1"> <a class="figref" href="#ph-gas_lab" title="перейти к рисунку">Рис. 96 ↓</a></span></p><figure class="photo reveal col" id="ph-gas_lab" data-x="1"><div class="ph-frame"><img src="data:image/webp;base64," alt="Фотография: Лаборатория газовой хроматографии" loading="lazy" decoding="async" width="1400" height="1050"></div><figcaption><b class="fig-n">Рис. 96.</b> <div class="cap2"><div class="c2 c2-w"><b>Что здесь.</b> Лаборатория газовой хроматографии.</div><div class="c2 c2-t"><b>К тексту.</b> Число обращений огрубляет семью, как температура огрубляет газ; но задача сменилась — спрашивают о нужде.</div></div><span class="credit">Фото: Hey Paul (Flickr) / <a href="https://commons.wikimedia.org/wiki/File:Gas_Chromatography_Laboratory_-_(1).jpg" target="_blank" rel="noopener">Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by/2.0" target="_blank" rel="noopener">CC BY 2.0</a></span></figcaption></figure><p>Решение остаётся в данных. Семья в список не попала, и в базе появилась строка: в программу не включена. В следующем году она войдёт в данные нового прогноза. Это четвёртая запись, Fₙ —[запись и удержание]→ Trₙ. Tr здесь — та самая строка, где семье отказали. Служба входит в новый год уже с ней. Это пятая запись, Sₙ —[локальное преобразование]→ Sₙ₊₁ (паспорт 4A.10).</p><p data-anchor="1">Дальше только предположение, его ещё предстоит проверить. Если семья без помощи станет обращаться реже, следующий прогноз окажется ещё ниже, и След закрепит слепоту модели. Запись Следа позволяет поставить измеримую задачу: проследить путь от строки в базе до следующего решения и оценить, как долго такие записи влияют на прогноз.<span class="figrefs" data-x="1"> <a class="figref" href="#viz-trace-loop" title="перейти к рисунку">Рис. 97 ↓</a></span></p><figure class="viz wide reveal mini4" id="viz-trace-loop" data-x="1" aria-label="Строка в базе → новый прогноз: предполагаемая петля"><div class="viz-kicker">Мини-схема · §4.4.3</div><h3 class="viz-title">Строка в базе → новый прогноз: предполагаемая петля</h3><span class="badge-hyp viz-hyp">гипотеза · не подтверждена</span><ol class="ch4 "><li style="--i:0"><b>Решение</b><span>семья не попала в список</span></li><li style="--i:1"><b>След Trₙ</b><span>строка «в программу не включена»</span></li><li style="--i:2"><b>Новые данные</b><span>строка войдёт в следующий прогноз</span></li><li style="--i:3"><b>Предположение</b><span>если семья станет обращаться реже, прогноз окажется ещё ниже</span></li></ol><p class="nt4">Дальше только предположение, его ещё предстоит проверить.</p><div class="cap2"><div class="c2 c2-w"><b>Что здесь.</b> Цепочка от решения службы до следующего прогноза; последний шаг — гипотеза.</div><div class="c2 c2-t"><b>К тексту.</b> Абзацы: отказ сохраняется строкой в базе и входит в данные нового прогноза; закрепит ли След слепоту модели, ещё предстоит проверить.</div></div><figcaption class="viz-foot"><span class="viz-src"><b class="fig-n">Рис. 97.</b> Строка в базе → новый прогноз: предполагаемая петля. Построено по тексту главы, §4.4.3</span><a class="viz-back" href="#4-4-3-odin-sluchai-ot-nachala-do-kontsa-sotsialn">к тексту §4.4.3 ↑</a></figcaption></figure><p>Сколько слияний можно разделить. Две семьи получили один прогноз. Одной помощь почти не нужна, другой нужна очень. Для задачи T′ это слитая пара. Проверка из §1.5, сравнение с независимой оценкой нужды при равном прогнозе, работает внутри таких пар, и индекс U превращает её в счёт. Ω — семьи района N, κ — прогноз, задача R (здесь T′) задаёт веса пар. Знаменатель D — вес всех пар с одинаковым прогнозом. Уточнение κ′ — «прогноз и независимая оценка нужды»: прежнюю метку оно сохраняет. Числитель N — вес слитых пар, которые оно разделяет. U = N/D по (1.32), паспорт 4A.15. U говорит, какую долю слияний прогноза разделяет оценка нужды. Справедливо ли распределена помощь, проверяет свой паспорт.</p><p data-anchor="1">Тот же счёт на другом масштабе. Одна температура сливает огромное множество микросостояний газа. Уточнение, например число молекул в левой половине сосуда при той же температуре, разделяет часть этих слияний. Чтобы считать буквально по (1.28), множество микросостояний нужно сделать конечным и заранее назвать задачу и веса.<span class="figrefs" data-x="1"> <a class="figref" href="#viz-u-scales" title="перейти к рисунку">Рис. 98 ↓</a></span></p><figure class="viz wide reveal mini4" id="viz-u-scales" data-x="1" aria-label="Один счёт U на трёх масштабах"><div class="viz-kicker">Инфотаблица · §4.4.3</div><h3 class="viz-title">Один счёт U на трёх масштабах</h3><div class="it4 " role="table" style="--n:4"><div class="it4-r it4-h" role="row"><span role="columnheader">Символ</span><span role="columnheader">Снимок (§4.4.2)</span><span role="columnheader">Служба (§4.4.3)</span><span role="columnheader">Газ</span></div><div class="it4-r" role="row"><span role="cell">Ω</span><span role="cell" data-h="Снимок (§4.4.2)">15 человек</span><span role="cell" data-h="Служба (§4.4.3)">семьи района N</span><span role="cell" data-h="Газ">микросостояния (множество нужно сделать конечным)</span></div><div class="it4-r" role="row"><span role="cell">κ</span><span role="cell" data-h="Снимок (§4.4.2)">возрастная группа</span><span role="cell" data-h="Служба (§4.4.3)">прогноз</span><span role="cell" data-h="Газ">температура</span></div><div class="it4-r" role="row"><span role="cell">κ′</span><span role="cell" data-h="Снимок (§4.4.2)">возраст + ветвь или место</span><span role="cell" data-h="Служба (§4.4.3)">прогноз и независимая оценка нужды</span><span role="cell" data-h="Газ">число молекул в левой половине сосуда при той же температуре</span></div><div class="it4-r" role="row"><span role="cell">R</span><span role="cell" data-h="Снимок (§4.4.2)">архивная опись</span><span role="cell" data-h="Служба (§4.4.3)">задача T′</span><span role="cell" data-h="Газ">нужно заранее назвать задачу и веса</span></div></div><div class="cap2"><div class="c2 c2-w"><b>Что здесь.</b> Таблица: одни и те же символы индекса U в трёх примерах главы.</div><div class="c2 c2-t"><b>К тексту.</b> Абзацы переносят тот же счёт со снимка на службу и на газ: везде нужны конечное Ω, критерий κ, уточнение κ′ и задача R.</div><div class="c2 c2-h"><b>Как читать.</b> Для каждого символа указано его значение в трёх примерах.</div></div><figcaption class="viz-foot"><span class="viz-src"><b class="fig-n">Рис. 98.</b> Один счёт U на трёх масштабах. Построено по тексту главы, §4.4.3</span><a class="viz-back" href="#4-4-3-odin-sluchai-ot-nachala-do-kontsa-sotsialn">к тексту §4.4.3 ↑</a></figcaption></figure><p>Что дал проход: каждый символ понадобился там, где без него ошибка оставалась невидимой. Рядом всё время шла первая запись, ГН ∥ Δ: точный ответ об обращениях сохраняет силу для своей задачи, а вопрос о нужде получает собственную проверку. Полные разборы — в приложении D; пределы раздела сведены в таблицу ниже.</p><p class="box limit">Граница вывода. Установлено: пять записей различают сопутствие горизонта, определённость формы, структуру различения, сохранение Следа и переход состояния. На ночной улице, на семейной фотографии, на схеме метро и в социальной службе каждая запись отвечает на свой вопрос. Учебный счёт индекса U показывает, какую долю слитых пар — выходов одной станции или семей с одним прогнозом — разделяют заранее разрешённые уточнения. Паспорта 4A.1–4A.18 держат класс, область и предел каждой записи. Остаётся гипотезой: помогает ли этот счёт выбирать уточнения и меняет ли паспорт решение службы. Не следует: читать пять записей как физический закон или как измерение горизонта; выводить из разбора улицы, что переживание устроено так же, как запись; принимать учебную дробь U за меру полноты знания или за подтверждение её пользы; переносить сходство улицы, фотографии и архива на тождество их механизмов. Подробнее — в таблице границ раздела ниже и в глоссарии запретов (приложение C). Открывает: проверку внешней полезности U (приложение E.3) и вопрос, как строка в базе службы доходит до следующего решения (§4.4.3).</p><p class="box selfcheck">Самопроверка раздела. 1. Какая из пяти записей отвечает на какой вопрос? 2. Где учебный счёт U кончается и начинается гипотеза о его пользе? 3. Что схема метро и социальная служба сливают — и какое заранее разрешённое уточнение это разводит? 4. Какой вывод о переживании или о справедливости помощи из этих записей не следует?</p><p>Границы применения раздела IV</p><div class="table-wrap tw-big" data-rows="12"><table><tr class="th-row"><th><p><strong>Чего раздел IV не утверждает</strong></p></th><th><p><strong>Тип ограничения (приложение C)</strong></p></th><th><p><strong>Где подробно</strong></p></th></tr><tr><td><p>Пять записей — не физический закон и не измерение; их число не означает пяти причин.</p></td><td><p>Запись — не закон и не измерение</p></td><td><p>Приложение C; приложение D, D.1</p></td></tr><tr><td><p>Ни ГН, ни запись различения не производят звук, форму или След; компоненты A, ¬κA, Γκ, Rκ — не этапы рождения объектов.</p></td><td><p>ГН — не причина</p></td><td><p>4A.7; приложение C</p></td></tr><tr><td><p>Разбор ночной улицы — чтение записи на сцене. Он не доказывает, что формула описывает переживание, не задаёт механизм внимания и не показывает возникновения феноменальности.</p></td><td><p>Нет вывода о сознании — ни за, ни против; от организации к переживанию — только через мост</p></td><td><p>4A.13, 4A.14; §2.12</p></td></tr><tr><td><p>Тишина как ¬κA — фон одной минуты в объявленной области, а не «ничто», скрытый резервуар или вся остальная действительность.</p></td><td><p>Граница описания — не неисчерпаемость мира</p></td><td><p>4A.8; §2.3</p></td></tr><tr><td><p>Общая схема улицы, фотографии и архива не устанавливает тождества их механизмов.</p></td><td><p>Сходство — не тождество и не приоритет</p></td><td><p>Приложение C</p></td></tr><tr><td><p>U примера с фотографией — учебная арифметика, а не мера ГН, полноты знания о людях, качества описи или значимости снимка.</p></td><td><p>Запись — не закон и не измерение</p></td><td><p>4A.15; приложение B.4</p></td></tr><tr><td><p>Ни этот пример, ни перебор приложения A не подтверждают полезности U или HCT-1; внешняя полезность остаётся гипотезой H1.3.</p></td><td><p>Успех одной проверки не переносится</p></td><td><p>Приложение A; приложение E.3</p></td></tr><tr><td><p>Тишина в разборе ночной улицы — не пустота; разбор условий (1.19) относится к уже существующему слушателю и ничего не говорит о возникновении различимости из полного отсутствия различий.</p></td><td><p>ГН — не причина; граница описания — не неисчерпаемость мира</p></td><td><p>§2.10; приложение C</p></td></tr><tr><td><p>U = 10/11 — не «знание семьи на 91 процент»; три неразделённые пары не доказывают неразличимости изображённых людей.</p></td><td><p>Предел модели не переносится без проверки; запись — не закон и не измерение</p></td><td><p>4A.15; приложение C</p></td></tr><tr><td><p>Сквозной случай службы (§4.4.3) условен и результатов не сообщает. Открытая задача — посчитать U на реальных данных с заранее объявленной оценкой нужды и проверить внешнюю полезность уточнения (H1.3).</p></td><td><p>Запись — не закон и не измерение; успех одной проверки не переносится</p></td><td><p>§1.5; 4A.15; приложение E.3</p></td></tr><tr><td><p>Газ, схема метро и служба сопоставлены по приёму огрубления, а не по механизму. Открытая задача — какие свойства счёта слитых пар сохраняются между масштабами.</p></td><td><p>Сходство — не тождество и не приоритет</p></td><td><p>4A.15; приложение C</p></td></tr></table></div><p>Дальше спросим, какую пользу эти записи дают на проверке.</p><aside class="sumcard reveal" id="sum-33" data-x="1" aria-label="Главное в подразделе"><div class="sum-k"><span class="sum-ic">★</span>Главное в подразделе · §4.4.3</div><ul><li>Что дал проход: каждый символ понадобился там, где без него ошибка оставалась невидимой.</li><li>Огрубление здесь рабочий инструмент, и в своих задачах он точен.</li></ul><div class="sum-f"><!--33-->Карточка-резюме: фразы из текста подраздела, без новых утверждений. <a href="#4-4-3-odin-sluchai-ot-nachala-do-kontsa-sotsialn">к началу подраздела ↑</a></div></aside><aside class="fn-list"><details><summary data-x="1">Сноски раздела · 1</summary><ol><li id="fn-114" value="114" data-fn="114"><div class="fn-body"><p><span class="clr" style="--c:#59616A"> Γκ — граница применения правила, а не линия в пространстве и не установленное событие в мозге; каков механизм сдвига внимания, запись не утверждает. Подробнее — приложение C.</span></p></div><a class="fn-back" href="#fnref-114" aria-label="Вернуться к тексту">↩</a></li></ol></details></aside></section></div></article><article class="part" id="part-V" data-part="V" style="--pc:#2b8a3e;--pk:#237032"><header class="cover" data-x="1" aria-label="Раздел V. Исследовательская программа: как проверять полезность различений"><img class="cover-img" src="data:image/webp;base64,