<script type="application/json" id="data">{"gloss": [{"term": "БЕДНОЕ НИЧТО", "d": "Отсутствие чего-либо внутри уже заданной рамки.", "role": "показывает обычное отрицание, которое нельзя смешивать с ГН.", "ex": "в чашке нет воды."}, {"term": "ГОРИЗОНТ НЕИСЧЕРПАННОСТИ (ГН)", "d": "[АВТОРСКОЕ] Регулятивный эпистемический горизонт неисчерпанности определения; правило не объявлять локальную область всей структурой предмета без отдельного основания.", "role": "Не субстанция, первопричина, энергия, уровень сознания или измеряемая переменная; не требует положительного количественного остатка в каждой конечной задаче.", "ex": "Карта может быть достаточна для маршрута, не представляя состав почвы."}, {"term": "НЕИСЧЕРПАЕМОСТЬ", "d": "В заглавии главы это имя вопроса о пределах определения, а не доказанный тезис, что всякое определение всегда неполно. Локальная неисчерпанность требует конкретного основания в заданной задаче; регулятивная открытость такого основания сама по себе не даёт.", "role": "Обозначает условие пересмотра без обещания обязательного остатка.", "ex": "новая находка меняет историческую классификацию."}, {"term": "ОПРЕДЕЛЕНИЕ", "d": "Операция фиксации признаков и границ понятия.", "role": "делает обсуждение точным, но зависит от задачи и языка.", "ex": "рабочее определение памяти в эксперименте."}, {"term": "РАЗНИЦА (δκ)", "d": "Установленная нетождественность относительно критерия κ.", "role": "фиксирует отличие без утверждения о системном событии.", "ex": "два тона различны по частоте."}, {"term": "РАЗЛИЧЕНИЕ (Δ, Δ̂κ)", "d": "[АВТОРСКОЕ] Δ — предельное условие определённости; Δ̂κ — локальная операция, делающая различие действенным для системы относительно κ.", "role": "Различает условие и операцию; ни одно не является автоматически числовой мерой Δκ.", "ex": "В модели названы альтернативы, затем происходит срабатывание по заданному правилу."}, {"term": "РАЗЛИЧИМОСТЬ (Δκ)", "d": "[АВТОРСКОЕ] Величина различимости при заданной мере и процедуре измерения.", "role": "Не состояние S, отношение δκ или операция Δ̂κ. Без объявленной меры числовое значение не задано.", "ex": "Оценённая по протоколу различимость двух стимулов, а не сам акт ответа."}, {"term": "ГРАНИЦА (Γ, Γκ)", "d": "[АВТОРСКОЕ] Регулируемая граница разделения сторон относительно критерия κ.", "role": "Не система отношений Rκ и не обязательно геометрическая поверхность; обмен и физический носитель требуют отдельной модели.", "ex": "Контур фигуры в описании; мембрана только в конкретном биологическом применении."}, {"term": "ФОРМА (F, Fκ)", "d": "Удерживаемая и воспроизводимая определённость.", "role": "сохраняет результат различения.", "ex": "мелодия узнаётся в разных исполнениях."}, {"term": "НОВАЯ ФОРМА (F′)", "d": "Форма после перестройки.", "role": "отмечает историческое изменение без гарантии прогресса.", "ex": "новая редакция теории после критического теста."}, {"term": "СЛЕД (Tr, Trₙ)", "d": "[АВТОРСКОЕ] Сохраняющееся изменение, влияющее на последующие состояния или различения.", "role": "Паспорт включает носитель, запись, считывание, срок удержания, стирание и вмешательство; не всякое событие автоматически оставляет доступный След.", "ex": "Архивная запись сохраняется и используется в последующем исследовании."}, {"term": "ГОРИЗОНТ", "d": "[ИНТЕРПРЕТАЦИЯ] Контекстуально обозначенная область возможных продолжений вопроса или опыта.", "role": "Не универсальная физическая сеть и не обязательно сам ГН; смысл уточняется регистром.", "ex": "Ответ может открыть новый вопрос, но не обязан делать это в каждой конечной задаче."}, {"term": "СОСТОЯНИЕ ПОСЛЕ ПЕРЕХОДА (Sₙ₊₁)", "d": "[ИНТЕРПРЕТАЦИЯ] Состояние системы на следующем шаге объявленного преобразования.", "role": "Не «открытость» и не изменившийся ГН; Sₙ₊₁≠Sₙ не утверждается безусловно, возможны сохранение и возврат.", "ex": "Состояние архива после обработки записи, включая случай отсутствия значимого изменения."}, {"term": "КРИТЕРИЙ (κ)", "d": "Основание, относительно которого проводится различие.", "role": "ограничивает область утверждения.", "ex": "сравнение образцов по массе, а не по цвету."}, {"term": "КОНТЕКСТ (K)", "d": "Совокупность условий применения модели.", "role": "определяет, где вывод имеет смысл.", "ex": "один симптом читается по-разному при разных возрастах и историях."}, {"term": "ОТНОШЕНИЕ (Rκ)", "d": "[АВТОРСКОЕ] Объявленное отношение сторон в схеме различения по κ.", "role": "Не граница Γκ и не задача R локального индекса; конкретное взаимодействие называется отдельно.", "ex": "Отношение выделенного сигнала к фону."}, {"term": "СОСТОЯНИЕ СИСТЕМЫ (S, Sₙ)", "d": "[АВТОРСКОЕ] Конфигурация системы Σ на выбранном шаге или интервале.", "role": "S обозначает состояние, Σ — организованное целое; стрелка между состояниями не является динамикой ГН.", "ex": "Предыдущая архивная редакция понятия."}, {"term": "ЛОКАЛЬНЫЙ ПОРОГ (τ)", "d": "Условие срабатывания в общей схеме главы 1.", "role": "отделяет слабое воздействие от зарегистрированного ответа.", "ex": "минимальный контраст для обнаружения фигуры."}, {"term": "ЛОКАЛЬНАЯ АСИММЕТРИЯ (ε)", "d": "[ИНТЕРПРЕТАЦИЯ] Названный перекос или возмущение в уже определённой модели; величина и единицы требуют спецификации.", "role": "Не создаёт первое различие, не гарантирует необратимости и не используется как предохранитель знаменателя U.", "ex": "Изменённое начальное условие с проверяемым ответом системы."}, {"term": "СТАБИЛИЗАЦИЯ", "d": "[ИНТЕРПРЕТАЦИЯ] Концептуальная схема удержания различимости, границы и отношений при названных условиях; русское написание прежнего Stab.", "role": "Указывает необходимый процесс, но не заменяет объяснения механизма; не один физический закон для всех уровней.", "ex": "Сохранение и повторное считывание записи при объявленном сроке удержания."}, {"term": "ПОЯВЛЕНИЕ ФОРМЫ (App)", "d": "[ИНТЕРПРЕТАЦИЯ] Дефиниционный статус: Fκ определена как различимая по κ в объявленной области.", "role": "Эквиваленция раскрывает употребление термина, а не достаточный физический механизм возникновения или удержания формы.", "ex": "Фрагмент определён как сигнал по правилу; его сохранение проверяется отдельно."}, {"term": "СВОЕДИНОЕ (СВ)", "d": "[АВТОРСКОЕ] Авторское имя задачи совместного удержания уже различённых полюсов, границы Γκ и отношения Rκ без сведения сторон к тождеству; механизм должен быть задан отдельно.", "role": "моделирует согласование различий.", "ex": "решение сохраняет и безопасность, и свободу как разные требования."}, {"term": "ФУНКЦИЯ УДЕРЖАНИЯ (H_ret)", "d": "[АВТОРСКОЕ] Функция удержания при названных условиях; удержание совместности в Своедином — одно из применений; работа удержания; её когнитивные, социальные и материальные затраты разобраны в §2.9.1.", "role": "Не U локального индекса, не H_ICS или ℋᴾ; механизм и временной масштаб указываются для конкретной модели.", "ex": "Сохранение различаемых полярностей и границы в одном анализе."}, {"term": "NExᴹ", "d": "[АВТОРСКОЕ] Дисциплина указания границ определённости и проверки переходов.", "role": "Не подменять объяснение ссылкой на ГН.", "ex": "Указать κ, контекст и условие пересмотра."}, {"term": "NExᴬ", "d": "Агентная способность удерживать альтернативное продолжение перед действием, вводимая в главе 8.", "role": "не смешивается с NExᴹ.", "ex": "человек сохраняет вторую возможность до решения."}, {"term": "РЕИФИКАЦИЯ", "d": "Ошибка превращения отношения, процесса или предела в самостоятельную вещь.", "role": "главная опасность онтологизации ГН.", "ex": "говорить, будто «неисчерпаемость» обладает энергией."}, {"term": "ОБЛАСТЬ ПРИМЕНИМОСТИ", "d": "Набор условий и вопросов, где модель обоснованно используется.", "role": "ограничивает перенос выводов.", "ex": "лабораторная шкала не описывает все жизненные контексты."}, {"term": "НЕГАТИВНАЯ СЕМАНТИКА ГН", "d": "Система запретов, определяющая, чем Горизонт неисчерпанности не является.", "role": "защищает понятие от псевдофизического и теологического расширения.", "ex": "ГН не считается вакуумом или Богом."}, {"term": "СТРУКТУРНОЕ СОПУТСТВИЕ (∥)", "d": "[АВТОРСКОЕ] Совместное рассмотрение определённости и регулятивного предела её исчерпывающей претензии.", "role": "Не причина, корреляция, физическая параллельность или одновременность.", "ex": "ГН ∥ Δ не означает, что ГН вызвал акт различения."}, {"term": "ПОСЛЕДОВАТЕЛЬНЫЙ ПЕРЕХОД (→)", "d": "Порядок внутри модели.", "role": "показывает ход процесса, но не заменяет механизм.", "ex": "решение ведёт к записи в протоколе."}, {"term": "ЛОГИКО-МОДЕЛЬНОЕ УСТАНОВЛЕНИЕ (⇒)", "d": "Введение результата операции в схему.", "role": "отличает модельный вывод от физического порождения.", "ex": "правило классификации устанавливает принадлежность классу."}, {"term": "ЭКВИВАЛЕНЦИЯ (⇔)", "d": "Связь «тогда и только тогда» в явно ограниченной области.", "role": "задаёт необходимое и достаточное условие модели.", "ex": "термин применим при выполнении всех заданных признаков."}, {"term": "ОТКРЫТИЕ ВОЗМОЖНОСТИ (⇝)", "d": "Переход без детерминирования.", "role": "связывает След со следующим различением, сохраняя альтернативы.", "ex": "находка открывает тему, но не предрешает вывод."}, {"term": "УСЛОВНЫЙ ПЕРЕХОД —[…]→", "d": "Переход через перечисленные условия или механизм.", "role": "делает скрытые предпосылки явными.", "ex": "стимул переходит в ответ через рецептор, критерий и порог."}, {"term": "НЕТOЖДЕСТВЕННОСТЬ ПО КРИТЕРИЮ (≠κ)", "d": "Различие только относительно κ.", "role": "блокирует всеобщий вывод из локального сравнения.", "ex": "образцы различны по массе, но совпадают по цвету."}, {"term": "НЕТOЖДЕСТВЕННОСТЬ СТАТУСОВ (≢)", "d": "[ИНТЕРПРЕТАЦИЯ] Различение репрезентации и предмета либо иных явно названных статусов описания.", "role": "Не числовая разность, не автоматическое доказательство физического дуализма или неполноты любого прогноза.", "ex": "Организационное описание не отождествляется с феноменальным переживанием одним переименованием."}, {"term": "ОПРЕДЕЛЕНИЕ (:=)", "d": "[ФАКТ] Введение значения символа или термина в явно объявленной области.", "role": "Отделяет соглашение от эмпирического результата; авторское происхождение и истинность не совпадают.", "ex": "Cκ определяется как набор слитых по κ неупорядоченных пар разных объектов."}, {"term": "УСЛОВИЕ (|)", "d": "[ИНТЕРПРЕТАЦИЯ] Чтение «при названных условиях» в контекстуальной записи.", "role": "Ограничивает применение записи формы; не превращает ГН в условную вероятность или изменяемую функцию.", "ex": "Fκ рассматривается при K, задаче R и истории Tr."}, {"term": "СИСТЕМА (Σ)", "d": "[АВТОРСКОЕ] Система как организованное целое, носитель состояний и переходов.", "role": "Не отдельное состояние S. Прежняя «сумма готовых форм» снята как формальная запись; оператор суммирования ∑ в U имеет стандартное математическое значение и область суммы.", "ex": "Σ — исследуемая система, Sₙ — её состояние на шаге n."}, {"term": "ИНДЕКС κ", "d": "[АВТОРСКОЕ] Указание критерия в символе.", "role": "Делает смысл относительным объявленному критерию, но сам по себе не обеспечивает измеримость или эмпирическую проверяемость.", "ex": "Fκ — форма, выделенная по критерию цвета."}, {"term": "ИНДЕКС n", "d": "Номер шага процесса.", "role": "различает состояния и Следы во времени модели.", "ex": "Sₙ — архив до записи, Sₙ₊₁ — после неё."}, {"term": "ШТРИХ (′)", "d": "[ИНТЕРПРЕТАЦИЯ] Обозначение перестроенной формы либо уточнённого критерия в своём паспорте.", "role": "Не численная степень новизны, не гарантия прогресса; формы ГН′ и ∅+′ не используются.", "ex": "F′ — перестроенная форма; κ′ — допустимое уточнение κ."}, {"term": "ПОЛЯРНОСТИ +1 / −1", "d": "Символические стороны различения, не числа и не моральные оценки.", "role": "позволяют удерживать напряжение в Своедином.", "ex": "поддерживающий и ограничивающий аргументы."}, {"term": "ВЫДЕЛЕННАЯ СТОРОНА A", "d": "То, что определено операцией различения.", "role": "задаёт фигуру.", "ex": "красные объекты при цветовом критерии."}, {"term": "ИНОЕ ¬κA", "d": "[ИНТЕРПРЕТАЦИЯ] Не включённое в A по κ в явно указанном универсуме.", "role": "Не вся вселенная и не противник; при неполной или небинарной классификации требуется отдельный статус неопределённости.", "ex": "Некрасные объекты в заданном наборе, а не все мыслимые вещи вообще."}, {"term": "КОНЦЕПТУАЛЬНАЯ СХЕМА", "d": "Запись отношений между понятиями без измерительных обязательств.", "role": "делает структуру мысли явной.", "ex": "ГН ∥ Δ."}, {"term": "ПРОЦЕССУАЛЬНАЯ СХЕМА", "d": "[ИНТЕРПРЕТАЦИЯ] Запись локальных переходов при уже заданных состояниях, операциях и условиях.", "role": "Требует отдельного механизма на каждом уровне; не начинается с ГН как причины.", "ex": "S —[Δ̂κ, условия]→ Fκ —[запись]→ Tr ⇝ условия следующего различения."}, {"term": "РЕГУЛЯТИВНАЯ СХЕМА", "d": "Правило ограничения метода, а не описание скрытого объекта.", "role": "удерживает открытость пересмотру.", "ex": "форма сопутствует ГН."}, {"term": "ОПРЕДЕЛИТЕЛЬНАЯ ЗАПИСЬ", "d": "Формальное введение значения термина или различия.", "role": "повышает однозначность.", "ex": "δκ(A,B): A ≠κ B."}, {"term": "СИМВОЛИКО-ОПЕРАЦИОНАЛЬНАЯ СХЕМА", "d": "Авторская запись, соединяющая символы с предполагаемыми операциями.", "role": "задаёт исследовательскую архитектуру до полной операционализации.", "ex": "будущая формализация Своединого."}, {"term": "КРИТЕРИЙ ПОРАЖЕНИЯ", "d": "Результат, при котором гипотеза должна быть пересмотрена.", "role": "отличает проверяемое утверждение от неуязвимой метафоры.", "ex": "протокол не снижает частоту категориальных ошибок."}, {"term": "ФИЗИЧЕСКИЙ УРОВЕНЬ", "d": "Измеримые материальные параметры и процессы.", "role": "описывает тело, нейроны, температуру и время по часам.", "ex": "частота нейронных импульсов."}, {"term": "БИОЛОГИЧЕСКИЙ УРОВЕНЬ", "d": "Жизнь и её регуляция.", "role": "описывает сон, дыхание, болезнь и старение.", "ex": "циркадный ритм."}, {"term": "КОГНИТИВНЫЙ УРОВЕНЬ", "d": "Внимание, память, прогноз, восприятие и контроль.", "role": "описывает обработку различий без автоматического вывода феноменальности.", "ex": "ошибка предсказания."}, {"term": "ФЕНОМЕНОЛОГИЧЕСКИЙ УРОВЕНЬ", "d": "То, как мир дан в опыте первого лица.", "role": "удерживает переживание отдельно от его измерения.", "ex": "ощущаемая тяжесть усталости."}, {"term": "ЯЗЫКОВОЙ УРОВЕНЬ", "d": "Слова, грамматика и повествование.", "role": "оформляет и преобразует опыт.", "ex": "имя меняет социальную адресацию человека."}, {"term": "НООСФЕРНЫЙ УРОВЕНЬ", "d": "Культура, коллективная память, институты, архивы и технологии.", "role": "задаёт внешний исторический фон формы.", "ex": "школьный канон."}, {"term": "СИМВОЛИЧЕСКИЙ УРОВЕНЬ", "d": "Миф, формула, образ, ритуал и знак.", "role": "организует смысл, но не получает физическую силу без основания.", "ex": "Искра как образ события различения."}, {"term": "ДУХОВНЫЙ УРОВЕНЬ", "d": "Открытое место для предельного опыта и признания границы знания.", "role": "фиксирует честное незнание, не доказывая отдельную субстанцию.", "ex": "опыт, который человек считает не исчерпанным семью другими описаниями."}, {"term": "МОСТОВОЙ АРГУМЕНТ", "d": "Явное обоснование перехода между уровнями.", "role": "запрещает вывод переживания из физики или онтологии из символа одним шагом.", "ex": "нейронная корреляция требует отдельного аргумента о переживании."}, {"term": "ТИШИНА", "d": "Образ условия слышимости и не подавленного фона.", "role": "символический, не физический механизм.", "ex": "пауза, в которой становится заметен слабый звук."}, {"term": "ИСКРА", "d": "Образ минимального локального различения.", "role": "готовит главу 2, не обозначая обязательную стадию природы.", "ex": "впервые замеченное отличие в знакомой сцене."}, {"term": "ВОЗГОРАНИЕ", "d": "Образ каскадной перестройки связанных различий.", "role": "отмечает пороговый режим.", "ex": "один факт меняет несколько взаимосвязанных выводов."}, {"term": "ПОЖАР", "d": "Образ предельной перестройки, при которой прежние формы теряют устойчивость.", "role": "литературная модель масштаба изменения.", "ex": "кризис парадигмы."}, {"term": "СВЕТ", "d": "Образ явленности формы.", "role": "показывает доступность различению и оценке.", "ex": "понятие становится ясным после точного определения."}, {"term": "ЭПИСТЕМИЧЕСКИЙ ГОРИЗОНТ", "d": "Предел и поле возможных продолжений знания.", "role": "рабочий регистр ГН.", "ex": "модель отвечает на вопрос и одновременно открывает новые вопросы."}, {"term": "ФЕНОМЕНОЛОГИЧЕСКИЙ ГОРИЗОНТ", "d": "Структура возможных продолжений актуально данного в опыте.", "role": "философский сосед, а не тождество Горизонту неисчерпанности.", "ex": "видимая сторона предмета подразумевает невидимые стороны."}, {"term": "ПУСТОТНОСТЬ", "d": "В мадхьямаке — отсутствие собственной независимой сущности, а не абсолютное небытие.", "role": "задаёт критический предел сопоставления с ГН.", "ex": "понятие действует только в сети языка, задач и отношений."}, {"term": "АБСОЛЮТНОЕ НИЧТО НИСИДЫ", "d": "Философское основание у Нисиды Китаро.", "role": "соседнее понятие для сопоставления, не источник физической формулы.", "ex": "анализ места самоотрицания противоположностей."}, {"term": "АПОФАТИКА", "d": "Дисциплина отрицания исчерпывающих имён Бога.", "role": "аналогия ограничения речи, не доказательство тождества Бога и ГН.", "ex": "отказ считать одно имя исчерпывающим."}, {"term": "ПЛАВАЮЩЕЕ ОЗНАЧАЮЩЕЕ", "d": "Знак с недостаточно фиксированным означаемым, поглощающий разнородные смыслы.", "role": "семиотическая опасность для ГН.", "ex": "слово, которым объясняют одновременно вакуум, Бога и сознание."}, {"term": "КВАНТОВЫЙ ВАКУУМ", "d": "[ФАКТ] Состояние квантовых полей в определённой физической теории, не отсутствие законов и структуры.", "role": "Не эмпирический эквивалент ГН; эксперименты и их поправки рассматриваются внутри физической постановки.", "ex": "Работа Lamoreaux об эффекте Казимира имеет Erratum 1998; она не проверяет метафизическое Ничто."}, {"term": "ИДЕАЛИЗАЦИЯ", "d": "Осознанное упрощение предмета в модели.", "role": "делает вычисление возможным при явных ограничениях.", "ex": "точечная масса в механике."}, {"term": "ПЕРСПЕКТИВА", "d": "Расположенный способ доступа к предмету.", "role": "объясняет избирательность модели без релятивизма.", "ex": "разные приборы выделяют разные параметры одного процесса."}, {"term": "СКРОМНЫЙ РЕАЛИЗМ", "d": "Признание реальности предмета и ограниченности конкретной перспективы.", "role": "удерживает точность без претензии на исчерпание.", "ex": "несколько согласованных моделей описывают разные стороны процесса."}, {"term": "РЕДУКЦИЯ", "d": "Сведение многоуровневого предмета к одному описанию.", "role": "допустима как метод, но ошибочна как автоматическое онтологическое тождество.", "ex": "объяснение переживания только частотой импульсов."}, {"term": "МУЛЬТИСТАБИЛЬНОСТЬ", "d": "Существование нескольких устойчивых режимов одной системы.", "role": "эмпирический сосед идеи перестройки, не подтверждение всей HCT1.", "ex": "двусмысленная фигура с двумя устойчивыми восприятиями."}, {"term": "МЕТАСТАБИЛЬНОСТЬ", "d": "[ИНТЕРПРЕТАЦИЯ] В обсуждаемой координационной модели — режим временных тенденций к совместному поведению при уже заданных компонентах и связях.", "role": "Не общее имя ГН; переходы в модели Kelso не обязательно требуют внешнего изменения параметров или шума.", "ex": "Задержки около остатков прежней координации сменяются расхождением фаз."}, {"term": "КОГНИТИВНАЯ НЕИСЧЕРПАЕМОСТЬ", "d": "Тезис о том, что рост знания способен открывать новые вопросы и уровни сложности.", "role": "интеллектуальный сосед, а не авторское открытие HCT1.", "ex": "решение одной научной задачи создаёт новый класс задач."}, {"term": "АГЕНТНЫЙ РАЗРЕЗ", "d": "У Барад — материально-дискурсивное установление различимости внутри феномена.", "role": "критический сосед Δ̂κ, не его эмпирическое подтверждение.", "ex": "измерительная конфигурация задаёт, какие величины становятся определёнными."}, {"term": "ТРАЕКТОРНАЯ ЗАВИСИМОСТЬ (PATH DEPENDENCE)", "d": "Зависимость последующего состояния от пройденной истории.", "role": "аналогия для Sₙ → Sₙ₊₁ до отдельной операционализации.", "ex": "одинаковый вход даёт разные результаты после разных историй обучения."}, {"term": "РЕКУРСИВНЫЙ ПРЕДЕЛ", "d": "Требование применять принцип неисчерпаемости к самому знаку ГН.", "role": "запрещает превращать его в последнее имя открытости.", "ex": "удалить символ, если он не указывает конкретную границу и способ пересмотра."}, {"term": "Аудит власти критерия", "d": "Проверка того, кто устанавливает κ, кого исключает и как граница оспаривается", "role": "Не уравнивает доказательную силу всех перспектив", "ex": "Возможность пересмотра институциональной классификации"}, {"term": "КАТЕГОРИАЛЬНЫЙ ПЕРЕНОС", "d": "Необоснованный перенос свойства, статуса или механизма между уровнями и регистрами.", "role": "первичная ошибка в проверке H1.1.", "ex": "объявить метафору физической причиной."}, {"term": "ИНФЕРЕНЦИАЛЬНАЯ ИНЕРТНОСТЬ", "d": "Оговорка об истоке не создаёт новых предметных выводов.", "role": "Требует собственных оснований каждого тезиса HCT-1.", "ex": "Удаление посылки о непознаваемости не лишает аргумент опоры."}, {"term": "МОДЕЛЬ ДОСТУПА", "d": "Явное описание доступных наблюдателю данных, состояний и операций.", "role": "Локализует ограничение знания.", "ex": "Наблюдателю доступно состояние подсистемы, но не все состояния целого."}, {"term": "НЕИДЕНТИФИЦИРУЕМОСТЬ ИСТОКА", "d": "Неразличимость заданных альтернатив истока допустимыми методами внутри определённой модели.", "role": "Не означает абсолютной невозможности любого знания.", "ex": "Новый метод различает альтернативы — прежнее ограничение пересматривается."}, {"term": "HCT1", "d": "Авторский протокол проверки исторической зависимости текущей формы при контроле входа.", "role": "связывает форму, След и последующее состояние.", "ex": "сравнение систем с разной историей при одинаковом текущем стимуле."}, {"term": "ICS", "d": "Профиль согласованности, требующий отдельной операционализации.", "role": "не является универсальным числом сознания.", "ex": "согласованность нескольких измерений системы без вывода о феноменальности."}, {"term": "ℋ", "d": "[АВТОРСКОЕ] Брендовое имя архитектуры HCT-1 / ICS / ℋ.", "role": "Не H_ret удержания, не U локального индекса; психофизическое мостовое предположение обозначается ℋᴾ отдельно.", "ex": "Обозначение модельного комплекса, не измеримая величина."}, {"term": "ℋᴾ", "d": "Ограниченная психофизическая мостовая гипотеза.", "role": "отделяет рискованное предположение от установленных организационных данных.", "ex": "проверяемая связь организации и отчёта об опыте."}, {"term": "ОРГАНИЗАЦИОННОЕ ОПИСАНИЕ (𝒪)", "d": "Описание структуры, функций и причинных зависимостей системы.", "role": "не тождественно переживанию.", "ex": "схема работы нейронной сети."}, {"term": "ФЕНОМЕНАЛЬНОСТЬ (𝒫)", "d": "Наличие переживания от первого лица.", "role": "не выводится автоматически из организации или символической формулы.", "ex": "как ощущается красный цвет."}, {"term": "[АВТОРСКОЕ]", "d": "Утверждённая каноническая конструкция книги/HCT-1/ICS/ℋ либо явно обозначенная авторская реконструкция в установленном режиме.", "role": "Не метка для всякого нового предложения агента; не знак истинности или эмпирической подтверждённости.", "ex": "Регулятивная запись ГН ∥ Δ; новое техническое предложение остаётся интерпретацией или гипотезой до согласования."}, {"term": "ИСПРАВЛЕНИЕ ИМЁН", "d": "Конфуцианское требование согласовать слова, роли и практические последствия.", "role": "проверяет, помогает ли термин ГН ответственному общению.", "ex": "назвать авторскую гипотезу гипотезой, а не законом."}, {"term": "ЗАВИСИМОЕ ВОЗНИКНОВЕНИЕ", "d": "Буддийская рамка, в которой явления рассматриваются через условия и связи, а не как самосущие вещи.", "role": "предохраняет открытость от превращения в первичную субстанцию.", "ex": "переживание тревоги зависит от тела, памяти, ситуации и интерпретации."}, {"term": "НЕДВОЙСТВЕННОСТЬ", "d": "В адвайте — критика окончательной самостоятельности различий, не равная пустому отсутствию.", "role": "запрещает отождествлять ГН с Брахманом.", "ex": "различие наблюдателя и наблюдаемого проверяется как условие опыта, а не объявляется исчезнувшим."}, {"term": "АПОРИЯ", "d": "Точно выявленное затруднение, которое останавливает ложное решение и уточняет вопрос.", "role": "сохраняет честную границу объяснения первого различения.", "ex": "всякая названная причина уже отличается от следствия."}, {"term": "РЕГУЛЯТИВНЫЙ ПРИНЦИП", "d": "Правило дисциплины мышления, не описывающее самостоятельную вещь.", "role": "задаёт статус ГН.", "ex": "требование искать границы модели не доказывает существование скрытой субстанции."}, {"term": "ГОРИЗОНТ ОПЫТА", "d": "Сеть неявных продолжений, на фоне которой дан предмет.", "role": "связывает феноменологию с открытостью без онтологического скачка.", "ex": "видимая сторона дома предполагает невидимые стороны, но не показывает их сразу."}, {"term": "ЭПОХЕ", "d": "Феноменологическое воздержание от поспешного онтологического утверждения ради анализа способа данности.", "role": "помогает отделить переживаемый горизонт от заявления о строении мира.", "ex": "описать, как неопределённость дана в опыте, прежде чем называть её физической реальностью."}, {"term": "СОСТАВНОЙ ПРОФЕССИОНАЛЬНЫЙ ГОЛОС", "d": "Авторская реконструкция типичного методологического возражения дисциплины, не приписанная конкретному человеку.", "role": "проверяет межуровневые переходы.", "ex": "физик запрещает отождествлять квантовый вакуум с философским Ничто."}, {"term": "ПРЕДЕЛ ПЕРЕНОСА", "d": "Явно обозначенная граница допустимой аналогии между традициями, моделями или уровнями.", "role": "не позволяет сходству слов становиться доказательством тождества.", "ex": "нейронное прогнозирование иллюстрирует модельность восприятия, но не доказывает метафизическую неисчерпаемость."}, {"term": "Эмпирическая неполнота", "d": "[АВТОРСКОЕ] Недостаточность данных для различения конкретных конкурирующих объяснений.", "role": "Отличать широкий интервал от отсутствия эффекта.", "ex": "Опыт не различает практически полезный выигрыш и ноль."}, {"term": "СТРУКТУРНАЯ НЕИДЕНТИФИЦИРУЕМОСТЬ", "d": "[ФАКТ] Разные допустимые параметры или состояния неразличимы через заданное отображение наблюдения в самой модели.", "role": "Не просто нехватка текущих данных и не автоматически то, что измеряет U; расширение доступа может изменить вывод.", "ex": "Два параметра дают одно и то же распределение всех наблюдаемых в принятой постановке."}, {"term": "РЕГУЛЯТИВНАЯ ОТКРЫТОСТЬ", "d": "Принципиальная возможность смены критерия и перспективы.", "role": "Философский смысл ГН.", "ex": "Новый вопрос меняет поле различений."}, {"term": "СЕМЕЙСТВО УТОЧНЕНИЙ (A)", "d": "[ИНТЕРПРЕТАЦИЯ] Заранее объявленное семейство допустимых критериев κ′, уточняющих κ.", "role": "Каллиграфическое обозначение рабочего параметра A индекса; не выделенная сторона A. Состав не подбирается по тестовым исходам.", "ex": "Два совместимых по постановке классификационных теста, заданных до анализа."}, {"term": "ВЕС ПАРЫ (wR)", "d": "[ИНТЕРПРЕТАЦИЯ] Неотрицательный конечный вес пары для заранее заданной задачи R.", "role": "Операционализация значимости, не доказательство полезности; веса не подбирают по тем же тестовым исходам, которые требуется предсказать.", "ex": "Все веса 1 дают обычную долю; общий положительный масштаб весов не меняет U=N/D."}, {"term": "ТЕСТ ГОМОЛОГИИ СЛЕДА", "d": "Сопоставление носителя, механизма, масштаба, стирания и вмешательства.", "role": "Предотвращает перенос слова «память» между уровнями.", "ex": "Trbio не объявляется Trepi."}, {"term": "ПРОГРЕССИВНЫЙ СДВИГ", "d": "Изменение теории, создающее независимое рискованное следствие.", "role": "Лакатосовский аудит HCT-1.", "ex": "H1.3 фиксируется до данных."}, {"term": "ГН_эпист", "d": "[АВТОРСКОЕ] Эпистемический регистр ограничения притязаний определения на полноту.", "role": "Полноту оценивают относительно задачи, критерия и доступных уточнений; локально полное решение допускается.", "ex": "Достаточная для маршрута карта не становится полным описанием города."}, {"term": "ГН_феном", "d": "[АВТОРСКОЕ] Феноменологический регистр ограничения: организационное описание 𝒪 не отождествляется с переживанием 𝒫 по определению.", "role": "Не отдельная сущность; не доказательство субстанциального дуализма и не запрет обоснованных мостовых гипотез.", "ex": "Точный прогноз отчёта не устанавливает одним определением тождество описания и опыта."}, {"term": "Uκ,A,R(Ω)", "d": "[ИНТЕРПРЕТАЦИЯ] Локальная доля веса пар, слитых κ и разделённых хотя бы одним заранее допустимым уточнением из A: N/D при D>0; NA при D=0.", "role": "R — задача. A — техническое написание параметра A. U семейства не ранжирует отдельные κ′; U=0 при бедном A не доказывает достаточности κ.", "ex": "Один тест разделяет 4 из 6 пар: 2/3; два вместе могут покрывать 6 из 6: 1."}, {"term": "Политика κ", "d": "Аудит происхождения, исключений, Следов и оспоримости критерия.", "role": "Проверка диагностического или кадрового порога.", "ex": "Порог диагностического теста задаёт, кто попадёт в категорию риска; изменение порога меняет социальные последствия классификации."}, {"term": "Σ / S", "d": "Σ — система как целое; S — её состояние.", "role": "Исключает коллизию глав 1–3.", "ex": "Σ — организм как система; S₁ — его состояние до вмешательства, S₂ — после него."}, {"term": "M_mem / M_meta / 𝔐", "d": "Память, метарефлексия и модель получают разные обозначения.", "role": "Одна буква M больше не несёт три функции.", "ex": "M_mem хранит эпизод, M_meta оценивает собственную уверенность, 𝔐 предсказывает следующий сигнал."}, {"term": "H_ret / H_ICS", "d": "Функция удержания и компонент профиля ICS разведены.", "role": "H_ret не тождественно ℋ или H_ICS.", "ex": "H_ret обозначает удержание различия во времени; H_ICS — отдельный компонент профиля сознательной интеграции."}, {"term": "RESEARCH-FIRST", "d": "порядок: проверка источников и возражений до существенной редакции", "role": "", "ex": "не заменяет систематический обзор"}, {"term": "статус источника", "d": "рецензированная статья, препринт, первоисточник или обзор", "role": "", "ex": "запрещает уравнивать разные уровни свидетельства"}, {"term": "ошибка информации", "d": "потеря из-за недостатка или состава данных", "role": "", "ex": "не равна ошибке представимости"}, {"term": "ПЕРЕНОСИМОСТЬ РАНЖИРОВАНИЯ", "d": "[ГИПОТЕЗА] Воспроизводимость порядка заранее заданных уточнений по внешней полезности после контроля сложности.", "role": "Для отдельного κ′ нужен одиночный score; для сравнения доменов — соответствие уточнений. Общий U семейства порядка не задаёт.", "ex": "Одинаковый набор сопоставимых тестов сохраняет либо не сохраняет порядок на независимой выборке."}, {"term": "ГН(Fκ | K, R, Tr)", "d": "[ИНТЕРПРЕТАЦИЯ] Контекст применения регулятива к форме Fκ при K, задаче R и истории Tr.", "role": "Не физическая функция и не изменяющийся горизонт; отношения сторон обозначаются Rκ отдельно.", "ex": "Новая архивная запись меняет доступные вопросы, а не значение скрытой переменной ГН."}, {"term": "Первопричина", "d": "Предполагаемое начальное событие или предельное основание; эти значения требуют разведения.", "role": "", "ex": "Более раннее событие не обязательно является полным объяснением."}, {"term": "Шуньята", "d": "Пустотность; в обсуждаемом мадхьямака-контексте связана с отсутствием самобытия и зависимым возникновением.", "role": "", "ex": "Не синоним физического вакуума или ГН."}, {"term": "Брахман и Tat", "d": "Понятия индийских традиций; Tat — «То», в данной главе обсуждается связь с адвайтическим прочтением.", "role": "", "ex": "Tat tvam asi не переводится буквально как «ТО = ЭТО»."}, {"term": "Логос", "d": "В прологе Иоанна — богословское Слово; не обычная человеческая лексема.", "role": "", "ex": "Ин. 1:1–3,14."}, {"term": "Чистая данность", "d": "Авторское обозначение непосредственного явления опыта без выделенного центра присвоения; не доказательство метафизической субстанции.", "role": "", "ex": "Описание «слышится дождь»."}, {"term": "Процессуальный язык", "d": "Приём описания с акцентом на событии, а не отдельном внутреннем хозяине действия.", "role": "", "ex": "«Сказалось», «живётся», «читается-пишется»."}, {"term": "Адресуемость Следа", "d": "Возможность установить участников создания, передачи и исправления записи.", "role": "", "ex": "Указание автора и истории редакций."}, {"term": "Интерсубъективная проверка", "d": "Независимое воспроизведение или оспаривание результата по доступной процедуре; не простое согласие.", "role": "", "ex": "Проверка термометра другим методом."}, {"term": "𝒰 и процедура «Проверка»", "d": "[ИНТЕРПРЕТАЦИЯ] 𝒰 — рабочее правило обновления модели; «Проверка» — названная процедура независимой проверки.", "role": "Это локальные обозначения примера; Π сохраняется для канонической воплощённой перспективы.", "ex": "Обновление оценки после внешнего эталонного измерения."}, {"term": "𝔐*, НЕПОДВИЖНАЯ ТОЧКА", "d": "[ФАКТ] Состояние модели, сохраняемое данным отображением при фиксированных входах.", "role": "Существование точки не означает её притягивания, сходимости итераций или истинности убеждения.", "ex": "У f(x)=x² точки 0 и 1 неподвижны, но производная в 1 равна 2."}, {"term": "q, α, β", "d": "[ИНТЕРПРЕТАЦИЯ] Координата и коэффициенты учебного уравнения dq/dt=αq−βq³, β>0.", "role": "Не измеренная ноосфера. При безразмерном q оба коэффициента имеют размерность обратного времени.", "ex": "При α<0 единственное действительное равновесие q=0 локально асимптотически устойчиво."}, {"term": "Ноосфера", "d": "Широкое имя коллективно-исторического слоя человеческой мысли и деятельности.", "role": "", "ex": "Общая история чтения и спора о книге."}, {"term": "Следосфера", "d": "Среда внешних Следов, их хранения, циркуляции, использования и коррекции.", "role": "", "ex": "Архив, цитирования, версии рукописи."}, {"term": "Носитель", "d": "Материальная или техническая структура, сохраняющая различие.", "role": "", "ex": "Бумага и чернила; накопитель и кодировка."}, {"term": "Информационная энтропия", "d": "Мера неопределённости распределения сигналов в определённой модели; сама по себе не истинность или смысл.", "role": "", "ex": "Единодушная ошибка может сопровождаться меньшим разнообразием ответов."}, {"term": "H1-ГН-L / H1-ГН-C / H1-ГН-T", "d": "Новые локальные гипотезы о процессуальном языке, независимой проверке и эпистемической маркировке; результаты ещё не получены.", "role": "", "ex": "Сравнение рандомизированных условий с заранее заданным отрицательным исходом."}, {"term": "Экспериенцер", "d": "Участник, переживающий состояние; не тождествен ни подлежащему, ни намеренному агенту.", "role": "", "ex": "«Мне» в «Мне грустно»."}, {"term": "Грамматическая безличность", "d": "Тип синтаксической организации; сам по себе не означает отсутствия переживающего или причин.", "role": "", "ex": "«Светает»; «Мне холодно»."}, {"term": "Процессуальная перспектива", "d": "Авторский фокус на протекании и условиях события; совместим с разной грамматикой.", "role": "", "ex": "«Я замечаю, как меняется решение»."}, {"term": "Авторское словообразование", "d": "Создание термина или образа с явным статусом; не доказательство этимологии.", "role": "", "ex": "«Дыхательство» с заданным определением."}, {"term": "Квантоподобная модель", "d": "Математическая схема, использующая соответствующий формализм для данных; не утверждение физического носителя.", "role": "", "ex": "Сравнение прогнозов последовательных ответов."}, {"term": "СЕПАРАБЕЛЬНОСТЬ ЧИСТОГО ВЕКТОРА", "d": "[ФАКТ] Представимость чистого вектора составной системы одним тензорным произведением векторов подсистем при данном разложении.", "role": "Не квантовая или психологическая независимость вообще; сепарабельность смешанного состояния имеет иное определение через смеси произведений.", "ex": "|a⟩⊗|b⟩ для двух заранее выбранных подсистем."}, {"term": "ТЕНЗОРНОЕ ПРОИЗВЕДЕНИЕ (⊗)", "d": "[ФАКТ] Конструкция составного пространства состояний при заданных подсистемах.", "role": "Не знак психологической привязанности; выбор подсистем входит в постановку.", "ex": "H_A⊗H_B; не «я привязан к мысли»."}, {"term": "Адрес ответственности за След", "d": "Возможность установить участника выбора, проверки и исправления записи.", "role": "", "ex": "Имя редактора и история версии."}, {"term": "App(Fκ)", "d": "Дефиниционное установление описательной формы как различимой по κ", "role": "Не физическое рождение и не достаточное условие удержания", "ex": "Определение класса правильных ответов"}, {"term": "H_ret", "d": "Отдельное условие удержания формы; механизм задаётся в локальной модели", "role": "Не выводится из одной различимости", "ex": "Сохранение доступной записи после операции"}, {"term": "¬κA", "d": "Дополнение A в явно указанном универсуме относительно критерия", "role": "Не ноумен, не вся вселенная и не моральное зло", "ex": "Высказывания заданного класса, не соответствующие критерию обещания"}, {"term": "Редукция (гуссерлевская)", "d": "Методическое приостановление определённого полагания естественной установки для исследования данности", "role": "Не очищение от мыслей и не отрицание существования мира", "ex": "Исследовать изменение явления предмета без поспешного онтологического вывода"}, {"term": "Неидентифицируемость", "d": "Невозможность различить допустимые альтернативы по доступным результатам внутри заданной модели", "role": "Требует явных методов и предпосылок; может пересматриваться при их изменении", "ex": "Разные истории дают одну запись датчика"}, {"term": "Вагусность", "d": "В рассматриваемом определении Пирса внутренняя неопределённость применения выражения", "role": "Не обязательно недостаток фактов у интерпретатора", "ex": "Неясность правила применения слова «обещание»"}, {"term": "Генеалогия понятия", "d": "Сравнение предшествующих вопросов, значений и способов обоснования", "role": "Ограничивает присвоение новизны и ложное отождествление", "ex": "Развести trace Деррида и типизированный Tr"}, {"term": "[ИНТЕРПРЕТАЦИЯ] A", "d": "Заранее допустимое семейство уточнений κ; каллиграфическое написание параметра A индекса", "role": "Рабочий технический паспорт, не сторона A", "ex": "Два доступных теста"}, {"term": "[ФАКТ] NA для U", "d": "Отсутствие определённой доли при D=0", "role": "Не числовой ноль и не отрицательное свидетельство", "ex": "Нет слитых пар с положительным весом"}, {"term": "[ИНТЕРПРЕТАЦИЯ] Контекст после Следа", "d": "Условия новых вопросов и действий после сохранённого изменения", "role": "Не динамическое ГН′", "ex": "Новый архив меняет доступный анализ"}, {"term": "Структурная неразличимость", "d": "[ИНТЕРПРЕТАЦИЯ] Разные модельные состояния или параметры дают одинаковые наблюдения при заданном дизайне.", "role": "Направлять изменение измерения или модели; не доказывать скрытую сущность.", "ex": "Дополнительный измерительный канал может снять неразличимость."}, {"term": "Паспорт κ", "d": "[АВТОРСКОЕ] Явное описание критерия, задачи, полномочий, области действия и исправления последствий.", "role": "Техническая и институциональная проверяемость различения.", "ex": "Указать цель, прокси, ошибки и порядок апелляции."}, {"term": "Прокси", "d": "[ИНТЕРПРЕТАЦИЯ] Измеряемый показатель, используемый вместо непосредственно интересующей цели.", "role": "Проверять обоснованность замены, а не только точность относительно метки.", "ex": "Расходы не тождественны потребности в медицинской помощи."}, {"term": "Uκ,A,R", "d": "[ИНТЕРПРЕТАЦИЯ] Предложенная редакцией нормировка канонической локальной диагностики: доля N/D веса слитых κ пар, разделимых хотя бы одним допустимым уточнением, при D>0; иначе NA.", "role": "Диагностировать доступное уточнение в конкретной задаче, не измерять ГН.", "ex": "Для одного разбиения четырёх объектов U=2/3."}, {"term": "NA в определении U", "d": "[ИНТЕРПРЕТАЦИЯ] При нулевом знаменателе доля не определена; это ограничение записи, а не самостоятельное положение канона.", "role": "Не превращать невозможность вычисления в содержательный ноль.", "ex": "Если нет слитых пар положительного веса, U=NA."}, {"term": "J(κ′)", "d": "[ИНТЕРПРЕТАЦИЯ] Рабочее определение, предложенное при подготовке главы: J(κ′)=Uκ,{κ′},R при D>0; при D=0 — NA. Прогностическая полезность проверяется отдельно.", "role": "Связать отдельное уточнение с независимо измеренным уменьшением внешней потери.", "ex": "Два одиночных уточнения могут иметь одинаковый J, хотя семейное U выше."}, {"term": "Эквивалентностная проверка", "d": "[ФАКТ] Проверка попадания эффекта в заранее обоснованные границы практической незначимости.", "role": "Различать локальный отрицательный и неопределённый исход.", "ex": "Незначимый обычный тест сам по себе эквивалентности не устанавливает."}, {"term": "ΔHist", "d": "[ИНТЕРПРЕТАЦИЯ] Добавочная предсказательная ценность истории относительно явно заданной модели текущего состояния.", "role": "Проверять локальное объяснение скрытым настоящим; остаток не доказывает ℋᴾ.", "ex": "При заранее перечисленном текущем состоянии проверить модельное допущение его достаточности и роль способа представления."}, {"term": "Независимый канал", "d": "[АВТОРСКОЕ] Проверка, независимая в отношении конкретного спорного основания, а не только исполнителя.", "role": "Различать точность и согласие в H1-ГН-C.", "ex": "Внешнее измерение вместо ещё одного пересказа общего источника."}, {"term": "Неопределённый исход", "d": "[ФАКТ] Данные недостаточно точны, чтобы отделить существенную пользу от практического нуля или вреда.", "role": "Не засчитывать отсутствие решения как подтверждение или опровержение.", "ex": "Интервал пересекает и ноль, и границу значимого выигрыша."}, {"term": "Task-relative completeness / достаточность для задачи", "d": "Достаточность модели для конкретного вопроса, условий и процедуры оценки", "role": "Не переносится автоматически на другой вопрос", "ex": "Карта метро полна для выбора пересадки, но недостаточна для расчёта несущей способности тоннеля."}, {"term": "Паспорт объяснения", "d": "Восемь полей: explanandum, вопрос, уровень, основания, механизм/правило, мост, альтернатива, условие поражения", "role": "[АВТОРСКОЕ]; редакционный инструмент, не научный закон", "ex": "Для вывода о памяти указываются данные, модель, альтернативы, вмешательство, уровень и результат, который заставит отказаться от тезиса."}, {"term": "Мостовая посылка", "d": "Дополнительное основание перехода между типами предметов или свидетельств", "role": "Должна иметь независимый аргумент/проверку", "ex": "Из корреляции активности области мозга с болью к тезису “эта активность и есть боль” нужен отдельный аргумент."}, {"term": "Инференциальная инертность ГН", "d": "Положительный тезис должен сохранять независимое основание после удаления фразы о неизвестности истока", "role": "Редакционный тест, не доказанная теорема всей HCT-1", "ex": "Фраза “модель не исчерпывает человека” сама по себе не предсказывает результат терапии."}, {"term": "Временное / логическое / модельное / феноменологическое первое", "d": "Четыре разных порядка первенства", "role": "Не взаимозаменяемы", "ex": "Самая ранняя запись события, исходная посылка модели и первое замеченное переживание могут не совпадать."}, {"term": "Нехватка данных", "d": "Нужное наблюдение ещё не получено", "role": "Не равно неразрешимости", "ex": "Не хватает измерений сна за несколько ночей; дополнительная регистрация может закрыть пробел."}, {"term": "Ограничение канала", "d": "Текущий доступ сливает различимые иным способом случаи", "role": "Может измениться с новым каналом", "ex": "Термометр различает температуру, но не химический состав; нужен другой прибор."}, {"term": "Модельная неидентифицируемость", "d": "Разные альтернативы дают одинаковые доступные результаты в заданной модели", "role": "Всегда указывать модель, наблюдаемые и альтернативы", "ex": "Две разные модели дают одинаковые прогнозы при всех предусмотренных наблюдениях."}, {"term": "Недоопределённый вопрос", "d": "Не задано, что считается ответом и как его проверять", "role": "Требует исправления вопроса, не новой сущности", "ex": "Вопрос “что было первым?” неразрешим, пока не указано: первым во времени, в логике или в опыте."}, {"term": "Слабый интерфейс", "d": "Воплощённая, перспективная и задачезависимая организация доступа", "role": "Не означает создания внешнего мира", "ex": "Зрение отбирает пригодные для действия признаки, не доказывая, что внешний предмет создан восприятием."}, {"term": "Interface Theory of Perception (ITP)", "d": "Эволюционная программа Хоффмана о конкуренции fitness- и truth-настроенных стратегий", "role": "Модельно-зависима; не доказывает идеализм", "ex": "В эволюционной игре стратегия, настроенная на fitness, может выигрывать у truth-стратегии при заданных функциях и мире модели."}, {"term": "Conscious Agent Network (CAN)", "d": "Формальная программа сетей взаимодействующих «сознательных агентов»", "role": "Имя переменной не доказывает феноменальность", "ex": "Узлы формальной сети названы агентами, но одно название не устанавливает наличие переживания у узла."}, {"term": "Prediction error (PE)", "d": "Модельно заданное расхождение между ожидаемым и поступившим сигналом", "role": "PE ≠ Искра ≠ осознанное удивление", "ex": "Пустая чашка оказывается легче ожидаемого; расхождение может возникнуть без осознанной Искры и долговременного Следа."}, {"term": "Физический наблюдатель", "d": "Детектор, подсистема или алгебра доступных наблюдаемых", "role": "Не автоматически феноменальный субъект", "ex": "Фотодетектор регистрирует квант света, не становясь тем самым субъектом переживания."}, {"term": "Феноменальный субъект", "d": "Перспектива первого лица, которой дан опыт", "role": "Не выводится из слова «наблюдатель»", "ex": "Человек сообщает, как ему переживается боль; отчёт нельзя заменить одним показанием датчика."}, {"term": "Кроссперспективная устойчивость", "d": "Сохранение отношений при смене наблюдателя, прибора или модели", "role": "Кандидатная интерпретация объективности, не определение вещи в себе", "ex": "Разные телескопы и группы получают совместимые оценки спектральной линии после калибровки."}, {"term": "Антимагический тест", "d": "Проверка переходов «неизвестно → причина», «значимо → внешний замысел», «коррелирует → причиняет»", "role": "Не обесценивает феноменологический/духовный смысл", "ex": "Значимое совпадение сохраняют как опыт, но не объявляют внешним замыслом без независимой проверки механизма."}, {"term": "Эпистемический предел", "d": "Граница обоснованного утверждения при заданных задаче, модели, языке, критерии и доступе.", "role": "Не является автоматически онтологическим пределом предмета.", "ex": "По имеющимся данным различимы два диагноза, но третий тест может изменить границу обоснованного вывода."}, {"term": "Ошибка представимости", "d": "Текущий язык или класс моделей не умеет выразить различие, важное для задачи.", "role": "Требует расширения представления; не сводится к нехватке данных.", "ex": "Двоичная шкала “болит/не болит” не выражает жгучий и пульсирующий характер боли; требуется более богатый язык описания."}, {"term": "Три П", "d": "Предсказание — Проба — Перепроверка: мнемоника цикла проверки различающей гипотезы.", "role": "Перепроверка допускает отрицательный результат; согласие не тождественно истине.", "ex": "Модель предсказывает эффект, вмешательство служит пробой, независимая выборка — перепроверкой."}, {"term": "Три устойчивости", "d": "Регулярность мира, устойчивость модели и интерсубъективная воспроизводимость.", "role": "Связаны, но ни одна не выводится автоматически из другой.", "ex": "Повторяемый природный цикл, устойчивый прогноз модели и согласие лабораторий проверяются разными процедурами."}, {"term": "Ограниченная структурная сопоставимость", "d": "Сравнение роли двух процессов при раздельной проверке носителя, механизма, временного масштаба, режима доступа и искажений.", "role": "Сходство функции не переносит физический или феноменальный механизм.", "ex": "Память мозга и архив сходны в сохранении доступа, но различаются носителем, механизмом, масштабом времени и типом искажений."}, {"term": "WHOLISTIC", "d": "[ФАКТ] Платформа объёмной регистрации кальциевой динамики у прозрачных позвоночных с коррекцией движения и вычислительным анализом.", "role": "Не универсальный переводчик межклеточных сообщений и не метод измерения сознания.", "ex": "Область, индикатор и временная частота задаются конкретным экспериментом."}, {"term": "Экспериментальный охват", "d": "[АВТОРСКОЕ] Доступный набор объектов, переменных, участков и временных масштабов в данной процедуре.", "role": "Не полнота состояния организма и не доказанная математическая наблюдаемость.", "ex": "Расширение кадра может открыть новые связи, не измеряя другие типы сигналов."}, {"term": "Функциональный ансамбль тканей", "d": "[ИНТЕРПРЕТАЦИЯ] Группа источников сигнала, выделенная по объявленному сходству динамики.", "role": "Не обязательно анатомическая единица, причинная сеть или субъект.", "ex": "Кластеризация по когерентности временных рядов."}, {"term": "Единица независимой репликации", "d": "[ИНТЕРПРЕТАЦИЯ] Единица, независимость которой обоснована дизайном; вложенные пробы учитываются отдельно.", "role": "Число пикселей, клеточных сегментов и повторов не равно числу независимых животных.", "ex": "Несколько сосудов и проб у одной рыбы образуют зависимые измерения."}, {"term": "Инструментальная запись и биологический След", "d": "[АВТОРСКОЕ] Сохранение сигнала в исследовательском файле и сохраняющееся изменение организма относятся к разным носителям.", "role": "Видеофайл не доказывает память клетки; хвост индикатора не доказывает последующего влияния.", "ex": "Для Tr указываются система, окно удержания и способ проверки воздействия."}]}</script>
