 $$('.pm-tabs button',m).forEach(function(b){b.addEventListener('click',function(){set(b.dataset.s)})});set('0')});
}catch(e){__err(65,e)}
try{$$('.gal-f').forEach(function(g){$$('button',g).forEach(function(b){b.addEventListener('click',function(){$$('button',g).forEach(function(x){x.classList.toggle('on',x===b)});var f=b.dataset.f;
 $$('.gal-c',g.parentNode).forEach(function(c){c.hidden=!(f==='all'||c.classList.contains(f))})})})});
}catch(e){__err(66,e)}
try{$$('#content .table-wrap table').forEach(function(t){var rows=t.rows;if(!rows.length)return;var hr=rows[0];if(hr.cells.length<2)return;t.classList.add('cardable');
 var heads=[].map.call(hr.cells,function(c){return (c.textContent||'').trim()});
 for(var i=1;i<rows.length;i++){[].forEach.call(rows[i].cells,function(c,k){if(heads[k])c.setAttribute('data-label',heads[k])})}});
}catch(e){__err(67,e)}
try{initHash();
}catch(e){__err(68,e)}
try{onScroll();
}catch(e){__err(69,e)}
try{var idle=window.requestIdleCallback||function(fn){return setTimeout(fn,60)};
}catch(e){__err(70,e)}
try{idle(function(){try{markGlossary()}catch(e){console.warn('glossary',e)}});
}catch(e){__err(71,e)}
window.__tvnOK=true;
})();
</script>
</body>
