<!DOCTYPE html>
<html lang="ru" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="generator" content="docx→html v3, источник md5 3bae04a0e3a12faeca39173e542f951c">
<title>Теория всего и ничего · Глава 1 · канон 7.2</title>
<script>(function(){var d=document.documentElement;d.className+=' js';window.addEventListener&&window.addEventListener('load',function(){if(!window.__tvnOK)d.className=d.className.replace(/(^| )js( |$)/g,' ')});})();</script>
<script>(function(){try{var t=localStorage.getItem('tvn72v3:theme');t=t?JSON.parse(t):(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=t;var f=localStorage.getItem('tvn72v3:fs');if(f)document.documentElement.style.setProperty('--fs',JSON.parse(f)+'px');}catch(e){}})();</script>
<style>@font-face{font-family:"TVNHat";src:url(data:font/woff;base64,) format("woff");unicode-range:U+0394,U+0302,U+25CC;font-display:block}
:root{--fs:19px;--col:42rem;--wide:1080px;--bg:#fbf8f3;--bg2:#f3eee5;--card:#ffffff;--tx:#1d2129;--mu:#5b6270;--ln:#e4ddd0;--acc:#d9480f;--navy:#0b1630;
--serif:"Iowan Old Style","Charter","Georgia","PT Serif","Noto Serif","DejaVu Serif",serif;--sans:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans","Helvetica Neue",Arial,sans-serif;
--sh:0 10px 30px -12px rgba(20,30,60,.25);--r:20px;--pc:#d9480f;--pk:#c2410c}
[data-theme=dark]{--bg:#0e131b;--bg2:#141b26;--card:#18202c;--tx:#e7e9ee;--mu:#a3abb9;--ln:#2a3342;--sh:0 10px 30px -12px rgba(0,0,0,.6)}
*{box-sizing:border-box}
html{font-size:var(--fs);scroll-padding-top:76px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--tx);font-family:var(--serif);line-height:1.68;text-rendering:optimizeLegibility}
a{color:var(--pk)}
[data-theme=dark] a{color:color-mix(in srgb,var(--pc) 55%,#fff)}
img{max-width:100%}
.skip{position:absolute;left:-999px}.skip:focus{left:8px;top:8px;z-index:99;background:#fff;padding:6px 10px}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid #ffb347;outline-offset:2px}
/* ---------- topbar ---------- */
#progress{position:fixed;top:0;left:0;right:0;height:3px;z-index:60}
#progress-bar{height:100%;width:0;background:var(--bar,#ffb347);transition:background .4s}
.topbar{position:fixed;top:0;left:0;right:0;height:60px;z-index:50;display:flex;align-items:center;gap:14px;padding:0 16px;font-family:var(--sans);font-size:15px;
background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--ln);transition:background .3s,color .3s,border-color .3s}
.topbar.on-hero{background:linear-gradient(rgba(5,10,25,.55),rgba(5,10,25,0));border-color:transparent;color:#fff}
.brand{display:flex;align-items:baseline;gap:8px;text-decoration:none;color:inherit;white-space:nowrap}
.brand-dot{width:12px;height:12px;border-radius:50%;background:radial-gradient(#ffe2a0,#f59f00);box-shadow:0 0 12px #ffb347;align-self:center}
.brand-t{font-family:var(--serif);font-weight:700;font-size:17px}.brand-s{color:var(--mu);font-size:13px}.on-hero .brand-s{color:#cfd6e6}
.menu{display:flex;align-items:center;gap:4px;margin-left:auto;flex-wrap:nowrap}
.menu>a{color:inherit;text-decoration:none;padding:7px 10px;border-radius:999px;white-space:nowrap}
.menu>a:hover,.menu>a.cur{background:color-mix(in srgb,var(--tx) 9%,transparent)}
.on-hero .menu>a:hover{background:rgba(255,255,255,.15)}
.menu-parts{display:flex;align-items:center;gap:4px;padding:0 6px}
.mp-l{font-size:13px;color:var(--mu);margin-right:2px}.on-hero .mp-l{color:#cfd6e6}
.np{display:inline-grid;place-items:center;min-width:30px;height:30px;padding:0 6px;border-radius:999px;background:var(--c);color:#fff!important;text-decoration:none;font-weight:700;font-size:13px;box-shadow:0 2px 6px -2px var(--c);transition:transform .15s}
.np:hover,.np.cur{transform:translateY(-2px) scale(1.08)}.np.cur{outline:2px solid color-mix(in srgb,var(--c) 40%,#fff)}
.tools{display:flex;gap:4px}
.tb{display:inline-grid;place-items:center;min-width:38px;height:38px;border:0;border-radius:12px;background:transparent;color:inherit;font-family:var(--sans);font-weight:600;font-size:14px}
.tb:hover{background:color-mix(in srgb,currentColor 12%,transparent)}
.tb svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
#btn-menu{display:none}
@media (max-width:1280px){.menu>a[data-nav=top],.mp-l{display:none}}
@media (max-width:1120px){.menu{display:none}#btn-menu{display:inline-grid}.tools{margin-left:auto}}
@media (max-width:560px){.hide-s,.brand-s{display:none}.topbar{padding:0 10px;gap:6px}}
/* ---------- hero ---------- */
.hero{position:relative;min-height:100vh;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden;color:#fff;background:#0b1630}
.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 60%;transform:scale(1.04);animation:kb 30s ease-out forwards}
@keyframes kb{to{transform:scale(1.12)}}
.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,12,30,.88) 0%,rgba(6,12,30,.55) 45%,rgba(6,12,30,.05) 75%),linear-gradient(0deg,rgba(6,12,30,.85),transparent 45%)}
.snowfall{position:absolute;inset:-20% 0 0 0;pointer-events:none;background-image:radial-gradient(2px 2px at 20px 30px,#fff,transparent),radial-gradient(2px 2px at 80px 120px,#fff,transparent),radial-gradient(1.5px 1.5px at 150px 60px,#fff,transparent),radial-gradient(2.5px 2.5px at 200px 160px,rgba(255,255,255,.8),transparent),radial-gradient(1.5px 1.5px at 260px 20px,#fff,transparent);background-size:300px 220px;opacity:.55;animation:snow 14s linear infinite}
@keyframes snow{to{transform:translateY(20%)}}
.hero-in{position:relative;z-index:2;max-width:760px;padding:0 6vw 12vh}
.hero-book{font-family:var(--sans);letter-spacing:.14em;text-transform:uppercase;font-size:14px;color:#ffd58a;margin:0 0 14px}
.hero-title{font-size:clamp(2.2rem,5.4vw,4.4rem);line-height:1.04;margin:0 0 18px;font-weight:700;letter-spacing:-.01em;text-shadow:0 4px 30px rgba(0,0,0,.5)}
.hero-sub{font-size:clamp(1.05rem,1.8vw,1.35rem);color:#e6ebf5;margin:0 0 22px;font-style:italic}
.hero-badge{display:inline-flex;align-items:center;gap:10px;font-family:var(--sans);font-size:14px;color:#e8edf6;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);padding:6px 14px 6px 6px;border-radius:999px;margin:0 0 28px;backdrop-filter:blur(6px)}
.hero-badge span{background:linear-gradient(135deg,#ffd58a,#f59f00);color:#2b1700;font-weight:800;padding:3px 10px;border-radius:999px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--sans);font-weight:650;font-size:16px;padding:13px 22px;border-radius:999px;border:1px solid var(--ln);background:var(--card);color:var(--tx);text-decoration:none}
.btn-primary{background:linear-gradient(135deg,#ffc860,#f08c00);color:#231300!important;border:0;box-shadow:0 10px 30px -10px #f59f00}
.btn-glass{background:rgba(255,255,255,.12);color:#fff!important;border-color:rgba(255,255,255,.35);backdrop-filter:blur(6px)}
.btn:hover{transform:translateY(-1px)}
.hero-down{position:absolute;z-index:2;bottom:22px;left:50%;transform:translateX(-50%);color:#fff;text-decoration:none;font-size:26px;opacity:.8;animation:bob 2s ease-in-out infinite}
@keyframes bob{50%{transform:translate(-50%,6px)}}
/* ---------- shared headings ---------- */
.sec-kicker{font-family:var(--sans);text-transform:uppercase;letter-spacing:.14em;font-size:13px;font-weight:700;color:var(--acc)}
.big-h{font-size:clamp(1.8rem,3.6vw,2.8rem);line-height:1.12;margin:.3em 0 .4em;letter-spacing:-.01em}
.five-lead{font-size:1.12rem;color:var(--mu);max-width:46rem}
/* ---------- five minutes ---------- */
.five{background:radial-gradient(1200px 500px at 85% 0%,rgba(255,179,71,.18),transparent),radial-gradient(900px 500px at 0% 100%,rgba(59,91,219,.12),transparent),var(--bg2);padding:110px 20px 90px}
.five-in,.route-in,.hub-head{max-width:var(--wide);margin:0 auto}
.five-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:34px 0}
.fc{background:var(--card);border-radius:var(--r);padding:26px 24px 22px;box-shadow:var(--sh);position:relative;border-top:5px solid var(--c,#f08c00)}
.fc:nth-child(1){--c:#3b5bdb}.fc:nth-child(2){--c:#2b8a3e}.fc:nth-child(3){--c:#e8590c}
.fc-n{position:absolute;top:-18px;right:20px;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--c);color:#fff;font:800 18px var(--sans)}
.fc h3{margin:0 0 8px;font-size:1.2rem}.fc p{margin:0;font-size:1rem}
.rule{background:var(--navy);color:#e9eef8;border-radius:28px;padding:28px;box-shadow:var(--sh);margin:10px 0 30px}
.rule-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.rule-tabs button,.ns-tog button,.u-presets button,.rs-tab,.gl-f button{border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:inherit;border-radius:999px;padding:8px 16px;font-family:var(--sans);font-size:14px;font-weight:600}
.rule-tabs button.on{background:#ffc860;color:#231300;border-color:#ffc860}
.rule-row{display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:stretch}
.rule-col{border-radius:20px;padding:20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);display:flex;flex-direction:column;gap:10px}
.rule-col.ok{border-color:rgba(81,207,102,.55)}.rule-col.new{border-color:rgba(255,169,77,.6)}
.rule-k{font-family:"Cambria Math","STIX Two Math",var(--serif);font-size:1.3rem;font-weight:700}
.rule-mtc{display:flex;gap:8px;flex-wrap:wrap}
.rule-mtc span{font-family:var(--sans);font-size:13px;background:rgba(255,255,255,.1);padding:4px 10px;border-radius:10px}
.rule-mtc i{font-family:var(--serif);font-weight:700;font-size:16px;margin-right:6px;color:#ffd58a}
.rule-mtc .chg{background:#e8590c;color:#fff}.rule-mtc .chg i{color:#fff}
.rule-ex{margin:0;font-size:1.02rem;flex:1}
.rule-badge{align-self:flex-start;font-family:var(--sans);font-size:13px;font-weight:700;padding:5px 12px;border-radius:999px}
.rule-badge.ok{background:#2f9e44;color:#fff}.rule-badge.need{background:#ffa94d;color:#2b1400}
.rule-arrow{display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:3rem;color:#ffa94d;line-height:1}
.rule-arrow small{font-family:var(--sans);font-size:12px;color:#c8d0e0;max-width:90px;text-align:center}
.rule-need{margin-top:18px;padding:14px 18px;border-radius:16px;background:rgba(255,200,96,.12);border:1px dashed rgba(255,200,96,.5)}
.rule-links{display:flex;gap:16px;flex-wrap:wrap;margin-top:14px;font-family:var(--sans);font-size:14px}
.rule-links a{color:#ffd58a}
.five-two{display:grid;grid-template-columns:1.1fr .9fr;gap:20px}
.axiom{margin:0;background:linear-gradient(135deg,#fff4dc,#ffe8c2);color:#2c1a00;border-radius:24px;padding:28px;box-shadow:var(--sh)}
[data-theme=dark] .axiom{background:linear-gradient(135deg,#3a2a10,#2a1e0c);color:#ffeccc}
.axiom p{font-size:1.25rem;line-height:1.5;margin:.4em 0 .8em;font-style:italic}
.axiom a,.rules4 a{font-family:var(--sans);font-size:14px}
.rules4{background:var(--card);border-radius:24px;padding:26px;box-shadow:var(--sh)}
.rules4 ol{margin:.6em 0 1em;padding-left:1.3em}.rules4 li{margin:.35em 0}
.rules4 li::marker{color:#2b8a3e;font-weight:800;font-family:var(--sans)}
/* ---------- route ---------- */
.route{background:linear-gradient(180deg,#0b1630,#101d3d);color:#e9eef8;padding:90px 20px 100px}
.route .five-lead{color:#c3cbe0}.route .sec-kicker{color:#ffc860}
.line{list-style:none;margin:50px 0 0;padding:0;display:grid;grid-template-columns:repeat(9,1fr);position:relative}
.line li{position:relative}
.line li::before{content:"";position:absolute;top:21px;left:0;right:0;height:10px;background:var(--c);opacity:.95}
.line li:first-child::before{left:50%;border-radius:6px 0 0 6px}.line li:last-child::before{right:50%;background:repeating-linear-gradient(90deg,var(--c) 0 10px,transparent 10px 16px)}
.line a{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;text-decoration:none;color:#fff;padding:0 4px}
.stn{width:52px;height:52px;border-radius:50%;background:#fff;border:9px solid var(--c);box-shadow:0 0 0 4px #0b1630,0 0 24px color-mix(in srgb,var(--c) 70%,transparent);transition:transform .2s}
.line a:hover .stn{transform:scale(1.15)}
.stn-num{position:absolute;top:13px;font:800 14px var(--sans);color:#0b1630}
.stn-t{margin-top:12px;font-weight:700;font-size:.95rem;line-height:1.25}
.stn-m{font-family:var(--sans);font-size:12px;color:#aeb8d0;margin-top:4px}
@media (max-width:900px){.line{grid-template-columns:1fr;gap:0}.line li::before{top:0;bottom:0;left:25px;right:auto;width:10px;height:auto}
.line li:first-child::before{top:26px;left:25px}.line li:last-child::before{bottom:50%;right:auto;background:repeating-linear-gradient(180deg,var(--c) 0 10px,transparent 10px 16px)}
.line a{flex-direction:row;text-align:left;gap:14px;padding:10px 0}.stn{flex:none;width:60px;height:60px;margin-left:-0px}.stn-num{left:0;width:60px;text-align:center;top:auto}.stn-t{margin:0}.stn-m{margin:0 0 0 auto}}
/* ---------- parts & cover ---------- */
main{display:block}
.part{--c:var(--pc)}
.cover{position:relative;min-height:94vh;display:flex;align-items:flex-end;color:#fff;overflow:hidden;background:#0b1630}
.cover-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.cover-shade{position:absolute;inset:0;background:linear-gradient(0deg,color-mix(in srgb,var(--pc) 55%,#050a18) 0%,rgba(5,10,24,.72) 45%,rgba(5,10,24,.15) 100%)}
.cover-in{position:relative;z-index:1;width:100%;max-width:var(--wide);margin:0 auto;padding:120px 24px 60px}
.cover-num{display:inline-block;font:800 14px var(--sans);letter-spacing:.16em;text-transform:uppercase;background:var(--pc);padding:7px 14px;border-radius:999px;box-shadow:0 6px 20px -6px var(--pc)}
.cover-title{font-size:clamp(2rem,4.6vw,3.6rem);line-height:1.08;font-weight:700;margin:18px 0 22px;max-width:22ch;text-shadow:0 4px 30px rgba(0,0,0,.45)}
.cover-q{margin:0 0 30px;max-width:40rem;border-left:4px solid #ffc860;padding:2px 0 2px 20px}
.cover-q p{font-size:clamp(1.15rem,2vw,1.45rem);font-style:italic;margin:0 0 6px;line-height:1.45}
.cover-q cite{font-family:var(--sans);font-size:14px;color:#ffd58a;font-style:normal}
.cover-meta{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;align-items:end}
.cover-card{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:20px;padding:18px 22px}
.cover-card h4{margin:0 0 8px;font:800 13px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:#ffd58a}
.cover-card ol{margin:0;padding-left:1.3em;font-size:1rem}.cover-card li{margin:.2em 0}
.cover-card a{color:#fff;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.35)}.cover-card a:hover{border-color:#fff}
.cover-more{margin:8px 0 0;font:13px var(--sans);color:#d5dcea}
.cover-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.cover-stats div{background:rgba(5,10,24,.45);border-radius:16px;padding:12px 10px;text-align:center}
.cover-stats b{display:block;font:800 1.5rem var(--sans)}.cover-stats span{font:12px var(--sans);color:#d5dcea}
.part-body{padding:40px 20px 80px}
.part-body>.docsec>*,.part-body>.doc-status{max-width:var(--col);margin-left:auto;margin-right:auto}
.part-body>.docsec>.wide,.part-body>.docsec>.table-wrap,.part-body>.docsec>.bridge{max-width:var(--wide)}
.docsec{padding-top:10px}
.doc-status{font:14px var(--sans);color:var(--mu);background:var(--bg2);border-radius:14px;padding:12px 16px}
.docsec h2{font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.18;margin:2.2em auto .6em;padding-top:.6em;border-top:4px solid var(--pc);letter-spacing:-.005em}
.docsec h2.part-h2{border:0;margin-top:.6em;padding:0;font:800 14px var(--sans);letter-spacing:.14em;color:var(--pk);line-height:1.5}
[data-theme=dark] .docsec h2.part-h2,[data-theme=dark] .docsec h3,[data-theme=dark] .docsec h4{color:color-mix(in srgb,var(--pc) 55%,#fff)}
.docsec h1{font-size:clamp(1.8rem,3.4vw,2.6rem);margin:1.6em auto .2em;line-height:1.15}
.docsec h3{font-size:1.4rem;line-height:1.25;margin:2em auto .5em;color:var(--pk)}
.docsec h4{font-size:1.15rem;margin:1.6em auto .4em;color:var(--pk)}
.anchor{opacity:0;margin-left:.3em;text-decoration:none;font-size:.7em;color:var(--mu)}h2:hover .anchor,h3:hover .anchor,h4:hover .anchor{opacity:.7}
.docsec p{margin:0 0 1em;hyphens:auto}
.subtitle{font-style:italic;color:var(--mu);font-size:1.15rem}
.subhead{font:800 13px var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--pk);margin-top:2em!important}
.epigraph{font-style:italic;font-size:1.2rem;text-align:center;background:linear-gradient(135deg,#0b1630,#1b2d5a);color:#f4e7c8;border-radius:24px;padding:30px;line-height:1.8;box-shadow:var(--sh)}
.epigraph-note{text-align:center;color:var(--mu);font-size:.95rem}
.code{font-family:"Cambria Math","STIX Two Math",var(--serif);background:var(--bg2);border-radius:12px;padding:12px 16px;text-align:center;font-size:1.05rem}
.math-display{overflow-x:auto;text-align:center;margin:1em auto;padding:10px;background:var(--bg2);border-radius:12px}
math{font-family:"TVNHat","Cambria Math","STIX Two Math","Latin Modern Math",var(--serif)}
.doc-list{padding-left:1.4em}.doc-list li{margin:.35em 0}.doc-list li::marker{color:var(--pk);font-weight:700}
/* boxes */
.box{position:relative;border-radius:18px;padding:18px 20px 18px 62px!important;box-shadow:var(--sh);background:var(--card);border:1px solid var(--ln)}
.box::before{position:absolute;left:16px;top:16px;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font:800 16px var(--sans);color:#fff}
.box.frame{background:color-mix(in srgb,var(--pc) 8%,var(--card));border-color:color-mix(in srgb,var(--pc) 35%,var(--ln))}.box.frame::before{content:"◎";background:var(--pc)}
.box.limit{background:color-mix(in srgb,#f59f00 10%,var(--card));border-color:color-mix(in srgb,#f59f00 45%,var(--ln))}.box.limit::before{content:"⚑";background:#e67700}
.box.selfcheck{background:color-mix(in srgb,#2f9e44 9%,var(--card));border-color:color-mix(in srgb,#2f9e44 40%,var(--ln))}.box.selfcheck::before{content:"✓";background:#2b8a3e}
.box.sci{background:color-mix(in srgb,#1971c2 8%,var(--card))}.box.sci::before{content:"i";background:#1971c2}
p.hyp{position:relative;border-radius:18px;padding:46px 20px 16px 20px;background:color-mix(in srgb,#7048e8 8%,var(--card));border:1px dashed color-mix(in srgb,#7048e8 55%,var(--ln))}
p.hyp::before{content:"Гипотеза · не подтверждена";position:absolute;top:12px;left:16px;font:800 12px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:#fff;background:#6741d9;padding:4px 10px;border-radius:999px}
.pull{position:relative;max-width:var(--col);margin:2.2em auto!important;padding:10px 0 10px 64px}
.pull-mark{position:absolute;left:0;top:-18px;font:900 100px/1 var(--serif);color:var(--pc);opacity:.85}
.pull p{font-size:1.5rem!important;line-height:1.4;font-style:italic;margin:0 0 8px!important;color:var(--tx)}
.pull-src{font:700 13px var(--sans);color:var(--pk);letter-spacing:.06em}
/* tables */
.table-wrap{position:relative;overflow-x:auto;margin:1.4em auto 1.8em;border-radius:16px;box-shadow:var(--sh);background:var(--card);border:1px solid var(--ln)}
.table-wrap table{border-collapse:collapse;width:100%;font-family:var(--sans);font-size:.8rem;line-height:1.5}
.table-wrap td,.table-wrap th{padding:10px 12px;vertical-align:top;border-bottom:1px solid var(--ln);text-align:left}
.table-wrap td p,.table-wrap th p{margin:0 0 .4em}.table-wrap td p:last-child{margin:0}
.table-wrap tr:first-child>*,.table-wrap tr.th-row>*{background:var(--pc);color:#fff;font-weight:700;border-color:transparent}
.table-wrap tr:first-child>* a{color:#fff}
.table-wrap tr:nth-child(even)>td{background:color-mix(in srgb,var(--pc) 5%,var(--card))}
.table-wrap.tw-big.clamped{max-height:440px;overflow:hidden}
.table-wrap.tw-big.clamped::after{content:"";position:absolute;left:0;right:0;bottom:0;height:120px;background:linear-gradient(transparent,var(--card));pointer-events:none}
.tw-btn{display:block;margin:-1.2em auto 1.8em;position:relative;z-index:2;font:700 14px var(--sans);background:var(--pc);color:#fff;border:0;border-radius:999px;padding:9px 18px;box-shadow:var(--sh)}
/* footnotes */
.fnref a{text-decoration:none;font:700 .68em var(--sans);background:color-mix(in srgb,var(--pc) 15%,transparent);color:var(--pk);padding:1px 5px;border-radius:6px;margin-left:1px}
.fn-list{max-width:var(--col);margin:2em auto 0!important;font-family:var(--sans);font-size:.82rem;color:var(--mu)}
.fn-list summary{cursor:pointer;font-weight:700;color:var(--pk);padding:10px 14px;background:var(--bg2);border-radius:12px;list-style:none}
.fn-list summary::before{content:"▸ "}.fn-list details[open] summary::before{content:"▾ "}
.fn-list ol{padding-left:2.2em}.fn-list li{margin:.5em 0}.fn-body p{margin:0 0 .3em}.fn-back{text-decoration:none;margin-left:6px}
.flash{animation:flash 1.6s ease}@keyframes flash{0%,40%{background:rgba(255,200,96,.45)}100%{background:transparent}}
mark.hit{background:#ffd43b;color:#000;border-radius:3px}
.gl{border-bottom:1.5px dotted color-mix(in srgb,var(--pc) 70%,transparent);cursor:help}
/* ---------- viz ---------- */
.viz{margin:2.4em auto!important;background:var(--card);border-radius:28px;padding:28px 30px 20px;box-shadow:0 20px 50px -24px rgba(20,30,60,.35);border:1px solid var(--ln);position:relative;overflow:hidden}
.viz::before{content:"";position:absolute;inset:0 0 auto 0;height:6px;background:linear-gradient(90deg,var(--pc),color-mix(in srgb,var(--pc) 40%,#ffc860))}
.viz-kicker{font:800 12px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--pk)}
.viz-title{font-size:1.55rem!important;line-height:1.2;margin:.3em 0 .4em!important;color:var(--tx)!important}
.viz-lead{color:var(--mu);margin:0 0 1.2em!important;font-size:1rem}
.viz-foot{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:18px;padding-top:12px;border-top:1px solid var(--ln);font:13px var(--sans);color:var(--mu)}
.viz-back{font-weight:700;text-decoration:none}
.ss-k{display:block;font:800 11px var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--mu);margin-bottom:4px}
.ord-note{font-size:.95rem;color:var(--mu);margin:16px 0 0!important}.sm{font-size:.85rem!important}
/* levels */
.levels{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.lv{position:relative;display:flex;align-items:center;gap:10px;text-align:left;border:2px solid var(--ln);background:var(--bg);color:var(--tx);border-radius:16px;padding:12px;font-family:var(--sans);font-size:15px;font-weight:650;transition:.2s}
.lv-n{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:hsl(calc(var(--i)*40 + 200),60%,48%);color:#fff;font-weight:800}
.lv-tag{position:absolute;top:-9px;right:8px;font-size:10px;background:#f08c00;color:#fff;padding:1px 7px;border-radius:999px}
.lv.lead{border-color:#ffc078}
.lv[aria-pressed=true]{border-color:var(--pc);background:color-mix(in srgb,var(--pc) 12%,var(--bg));transform:translateY(-2px)}
.lv-panel{margin-top:14px}.js .lv-card{display:none}.lv-card{background:var(--bg2);border-radius:18px;padding:18px 22px}.lv-card.on{display:block;animation:fadeIn .3s}
.lv-card h4{margin:0 0 6px!important;color:var(--tx)!important}.lv-card dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 16px}.lv-card dt{font:700 13px var(--sans);color:var(--mu)}.lv-card dd{margin:0}
.lv-ban{color:#c92a2a;font-weight:600}[data-theme=dark] .lv-ban{color:#ff8787}.arr{color:#c92a2a;font-size:1.2em}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}}
/* metro net */
.mn{display:grid;grid-template-columns:1.2fr 1fr;gap:20px;align-items:center}
.metro-net{width:100%;height:auto}
.metro-net .ln{fill:none;stroke-width:12;stroke-linecap:round}.metro-net .ln1{stroke:#e8590c}.metro-net .ln2{stroke:#1c7ed6}
.metro-net .route{fill:none;stroke:#ffd43b;stroke-width:4;stroke-dasharray:10 10;animation:dash 1.2s linear infinite}
@keyframes dash{to{stroke-dashoffset:-20}}
.metro-net .st circle{fill:#fff;stroke:#1d2129;stroke-width:5}.metro-net .hub circle{stroke-width:7}
.metro-net text{font:700 21px var(--sans);fill:var(--tx)}.metro-net text.sm{font-size:16px;fill:var(--mu);font-weight:500}
.metro-net .legend text{font-size:12px;font-weight:600;fill:var(--mu)}.metro-net .l1{fill:#e8590c}.metro-net .l2{fill:#1c7ed6}
.mn-side{display:flex;flex-direction:column;gap:12px}
.mn-q{border-radius:16px;padding:14px 16px;background:var(--bg2);border-left:6px solid #2f9e44}.mn-q.new{border-color:#f08c00}
.mn-k{font:800 11px var(--sans);letter-spacing:.1em;text-transform:uppercase;color:var(--mu);display:block}.mn-q b{display:block;margin:2px 0 6px}.mn-q p{margin:0!important;font-size:.95rem}
/* photo */
.ph-img{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:16/7}
.ph-img img{width:100%;height:100%;object-fit:cover;object-position:40% 70%}
.ph-tag{position:absolute;left:14px;top:14px;font:800 12px var(--sans);text-transform:uppercase;letter-spacing:.1em;background:#fff;color:#1d2129;padding:5px 10px;border-radius:999px}
.ph-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:-40px;position:relative;padding:0 14px}
.ph-c{background:var(--card);border-radius:18px;padding:16px;box-shadow:var(--sh);border-top:5px solid var(--c)}
.ph-c.c1{--c:#1c7ed6}.ph-c.c2{--c:#e8590c}.ph-c.c3{--c:#c2255c}
.ph-c h4{margin:6px 0 4px!important;color:var(--tx)!important}.ph-c p{margin:0!important;font-size:.95rem}
.ph-n{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--c);color:#fff;font:800 14px var(--sans)}
.ph-bridge{margin-top:16px;padding:16px 18px;border-radius:16px;background:var(--navy);color:#e9eef8}.ph-bridge p{margin:6px 0 0!important}
.fx{font-family:"Cambria Math",var(--serif);font-size:1.2rem;font-weight:700}.fx b{color:#ffa94d}
/* social service */
.ss{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center}
.ss-img img{border-radius:20px;width:100%;aspect-ratio:4/3;object-fit:cover}
.ss-flow{display:flex;flex-direction:column;gap:10px}
.ss-box{border-radius:16px;padding:14px 16px;color:#fff}.ss-box b{font-size:1.05rem}.ss-box .ss-k{color:rgba(255,255,255,.85)}
.ss-box.t{background:#2b8a3e}.ss-box.t2{background:#e8590c}
.ss-arrow{text-align:center;font:600 13px var(--sans);color:var(--mu)}.ss-arrow::before{content:"↓";display:block;font-size:26px;color:var(--pk)}
.ss-check{border:2px dashed var(--pc);border-radius:16px;padding:12px 16px}.ss-check p{margin:0!important;font-size:.95rem}
/* unknown */
.unk-cards{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.unk-card{display:flex;flex-direction:column;align-items:flex-start;gap:6px;text-align:left;border:2px solid var(--ln);background:var(--bg);color:var(--tx);border-radius:18px;padding:14px;min-height:130px;transition:.2s;--h:calc(var(--k,0)*1)}
.unk-card:nth-child(1){--uc:#1c7ed6}.unk-card:nth-child(2){--uc:#0b7285}.unk-card:nth-child(3){--uc:#6741d9}.unk-card:nth-child(4){--uc:#e67700}.unk-card:nth-child(5){--uc:#c2255c}
.unk-ic{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--uc);color:#fff;font-size:20px}
.unk-n{font:800 12px var(--sans);color:var(--mu)}.unk-t{font:700 15px var(--sans);line-height:1.25}
.unk-card[aria-pressed=true]{border-color:var(--uc);background:color-mix(in srgb,var(--uc) 12%,var(--bg));transform:translateY(-3px);box-shadow:var(--sh)}
.unk-pan{margin-top:14px}.js .unk-p{display:none}.unk-p{background:var(--bg2);border-radius:18px;padding:18px 22px}.unk-p.on{display:block;animation:fadeIn .3s}
.unk-p h4{margin:0 0 6px!important;color:var(--tx)!important}.unk-def{font-size:1.05rem}
.unk-row{display:grid;grid-template-columns:1fr 1.4fr;gap:14px}.unk-row p{margin:0!important;font-size:.95rem}
.unk-row>div{background:var(--card);border-radius:14px;padding:12px 14px}
/* orders */
.ord{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.ord-c{position:relative;border-radius:18px;padding:18px 16px;background:var(--bg2);border:2px solid transparent}
.ord-c.here{border-color:var(--pc);background:color-mix(in srgb,var(--pc) 10%,var(--card))}
.ord-ic{font-size:28px;display:block;color:var(--pk)}.ord-c h4{margin:6px 0!important;color:var(--tx)!important}.ord-c p{margin:0!important;font-size:.95rem}
.ord-tag{position:absolute;top:-11px;right:12px;font:800 11px var(--sans);background:var(--pc);color:#fff;padding:3px 9px;border-radius:999px}
/* steps4 */
.steps4{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0;counter-reset:s}
.steps4 li{position:relative;background:color-mix(in srgb,var(--pc) calc(10% + var(--i)*12%),var(--card));padding:22px 18px 22px 30px;font-weight:700;clip-path:polygon(0 0,88% 0,100% 50%,88% 100%,0 100%,12% 50%);display:flex;flex-direction:column;gap:6px;min-height:110px;justify-content:center}
.steps4 li:first-child{clip-path:polygon(0 0,88% 0,100% 50%,88% 100%,0 100%)}
.steps4 li:nth-child(n+3){color:#fff}
.s4-n{font:800 13px var(--sans);opacity:.75}
/* genealogy */
.gen{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;align-items:center}
.gen-lines{display:flex;flex-direction:column;gap:8px}
.gen-l{display:grid;grid-template-columns:110px 1fr;gap:12px;align-items:center;text-decoration:none;color:var(--tx);background:var(--bg2);border-radius:14px;padding:10px 14px;position:relative;border-left:6px solid hsl(calc(250 + var(--i)*22),60%,55%)}
.gen-l::after{content:"→";position:absolute;right:-16px;color:var(--pk);font-weight:800}
.gen-l b{font-size:1.05rem}.gen-l span{font-size:.92rem;color:var(--mu)}
.gen-l:hover{transform:translateX(4px)}
.gen-core{background:linear-gradient(135deg,#5f3dc4,#7950f2);color:#fff;border-radius:24px;padding:24px;box-shadow:var(--sh)}
.gen-core span{font:800 12px var(--sans);letter-spacing:.14em;text-transform:uppercase;opacity:.85}.gen-core p{margin:.4em 0 0!important;font-size:1.1rem}
/* night street */
.ns-tog{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.ns-tog button,.u-presets button,.gl-f button{border-color:var(--ln);color:var(--tx);background:var(--bg)}
.ns-tog button.on,.u-presets button.on,.gl-f button.on{background:var(--pc);border-color:var(--pc);color:#fff}
.ns-svg{width:100%;max-height:360px}
.ns-field{fill:#14213d}.ns-gamma{fill:none;stroke:#ffd43b;stroke-width:4;stroke-dasharray:8 8;animation:dash 1.6s linear infinite}
.ns-a{fill:#ffc860;filter:drop-shadow(0 0 18px #ffb347)}
.ns-at{font:800 34px var(--serif);fill:#2b1700;text-anchor:middle}.ns-as{font:700 15px var(--sans);fill:#2b1700;text-anchor:middle}
.ns-bt{font:800 17px var(--sans);fill:#ffd58a}.ns-bs{font:500 14px var(--sans);fill:#c3cbe0}.ns-lead{fill:none;stroke:#ffd58a;stroke-width:2}
.ns .ns-k1{display:none}.ns.k1 .ns-k1{display:inline}.ns.k1 .ns-k0{display:none}.ns.k1 .ns-a{fill:#74c0fc;filter:drop-shadow(0 0 18px #4dabf7)}
.ns-legend{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px;font-size:.92rem}.ns-legend b{color:var(--pk);margin-right:6px}
/* U calc */
.u-presets{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.u-main{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
.u-ctrl label{display:block;font:600 14px var(--sans);margin-bottom:14px}.u-ctrl output{float:right;font-weight:800;color:var(--pk)}
.u-ctrl input[type=range]{width:100%;accent-color:var(--pc);margin-top:6px}
.u-res{display:flex;align-items:center;gap:24px;background:var(--navy);color:#fff;border-radius:20px;padding:16px 22px}
.u-frac{display:inline-flex;flex-direction:column;align-items:center;font:800 2rem var(--sans);line-height:1.1}.u-num{border-bottom:3px solid #ffc860;padding:0 10px}
.u-eq{font:700 1.6rem var(--serif)}.u-eq b{color:#ffc860;font-size:2.4rem}
.u-explain{font-size:.95rem;margin:12px 0 0!important}
.u-vis{background:var(--bg2);border-radius:20px;padding:14px;min-height:240px}
.u-grid{display:flex;flex-wrap:wrap;gap:5px}
.u-grid i{width:22px;height:22px;border-radius:6px;background:color-mix(in srgb,var(--mu) 30%,transparent);transition:background .3s}
.u-grid i.on{background:var(--pc);box-shadow:0 0 8px color-mix(in srgb,var(--pc) 60%,transparent)}
.u-station{width:100%;height:auto;display:block}
.u-station text{font:700 12px var(--sans);fill:var(--tx);text-anchor:middle}
.u-motto{margin:18px 0 0!important;text-align:center;font:800 1.1rem var(--sans);color:#fff;background:linear-gradient(90deg,var(--pc),#f08c00);border-radius:999px;padding:10px 18px}
/* gas */
.gas{display:grid;grid-template-columns:1.6fr auto .8fr;gap:16px;align-items:center}
.gas-box{position:relative;border-radius:22px;overflow:hidden;background:radial-gradient(circle at 50% 40%,#1e3263,#0b1630);border:3px solid #a5d8ff55}
.gas-cv{width:100%;height:auto;display:block}
.gas-split{position:absolute;top:0;bottom:0;left:50%;border-left:3px dashed #ffd43b}
.gas-lr{position:absolute;inset:auto 0 8px 0;display:flex;justify-content:space-around;font:800 15px var(--sans);color:#ffd43b}
.gas-arrow{font:800 16px var(--sans);color:var(--pk)}
.gas-t{display:flex;align-items:center;gap:14px}
.thermo{width:26px;height:200px;border-radius:13px;background:#e9ecef;border:3px solid #adb5bd;position:relative;overflow:hidden}
.thermo-fill{position:absolute;left:0;right:0;bottom:0;height:62%;background:linear-gradient(#ff8787,#e03131)}
.gas-tl b{display:block;font-size:1.3rem}.gas-tl span{color:var(--mu);font-family:var(--sans)}
.gas-btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.gas-btns button,.fam-btn{border:0;border-radius:999px;padding:10px 18px;font:700 14px var(--sans);background:var(--pc);color:#fff}
.gas-btns .gas-pause{background:var(--bg2);color:var(--tx)}
.gas-note{margin:10px 0 0!important}
/* incompleteness */
.inc{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.inc-c{border-radius:20px;overflow:hidden;background:var(--bg2)}
.inc-img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}
.inc-b{padding:14px 16px}.inc-b h4{margin:2px 0 6px!important;color:var(--tx)!important}.inc-b p{margin:0!important;font-size:.95rem}
/* hyps */
.hy-banner{font:800 1.1rem var(--sans);background:#f3f0ff;color:#5f3dc4;border-radius:14px;padding:12px 16px;text-align:center}
[data-theme=dark] .hy-banner{background:#2b2350;color:#d0bfff}
.hy{border-radius:18px;border:1px solid var(--ln);margin-top:12px;overflow:hidden}
.hy-h{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:12px 16px;background:var(--bg2)}.hy-h b{font:800 1.1rem var(--sans)}
.badge-hyp,.badge-know{font:800 11px var(--sans);letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;border-radius:999px;background:#6741d9;color:#fff}
.badge-know{background:#495057}
.hy-row{display:grid;grid-template-columns:1fr 1fr}.hy-row>div{padding:12px 16px}.hy-row p{margin:0!important;font-size:.95rem}
.hy-fail{background:color-mix(in srgb,#e03131 6%,var(--card))}
/* families */
.fam-row{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:center}
.fam-c{border-radius:20px;padding:18px;background:var(--bg2);position:relative;transition:.4s}
.fam-ic{font-size:34px;color:var(--pk)}.fam-c h4{margin:2px 0 4px!important;color:var(--tx)!important}.fam-c p{margin:0 0 10px!important;font-size:.95rem}
.need{font:800 12px var(--sans);padding:4px 10px;border-radius:999px;color:#fff;opacity:.25;transition:.4s}.need.low{background:#2f9e44}.need.high{background:#e03131}
.fam-mid{text-align:center;display:flex;flex-direction:column;gap:8px;align-items:center;transition:.4s}
.fam-pred{background:var(--navy);color:#fff;border-radius:16px;padding:14px 16px;font-family:var(--sans)}.fam-pred b{color:#ffc860;display:block;font-size:1.2rem}
.fam-name{font:700 13px var(--sans);color:var(--pk)}
.fam.split .need{opacity:1}.fam.split .f1{transform:translateX(-6px)}.fam.split .f2{transform:translateX(6px);box-shadow:0 0 0 3px #e03131}
.fam.split .fam-pred{opacity:.55}
.fam-btn{margin-top:16px}.fam-out{margin:10px 0 0!important;font-size:.98rem}
/* success/fail */
.sf{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.sf-c{border-radius:20px;padding:18px 20px}.sf-c h4{margin:0 0 8px!important;font-size:1.2rem;color:var(--tx)!important}
.sf-c.ok{background:color-mix(in srgb,#2f9e44 10%,var(--card));border:2px solid color-mix(in srgb,#2f9e44 40%,transparent)}
.sf-c.no{background:color-mix(in srgb,#495057 9%,var(--card));border:2px solid color-mix(in srgb,#495057 30%,transparent)}
.sf-c ul{margin:12px 0 0;padding-left:1.2em}.sf-c li{margin:.4em 0;font-size:.97rem}
/* bridge */
.bridge{position:relative;border-radius:30px;overflow:hidden;margin:3em auto 0!important;min-height:520px;display:flex;align-items:flex-end;color:#fff;box-shadow:var(--sh)}
.bridge-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 40%}
.bridge-in{position:relative;padding:40px;background:linear-gradient(0deg,rgba(5,8,18,.9),rgba(5,8,18,0));width:100%}
.bridge-k{font:800 13px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:#ffc860}
.bridge-q{font-size:clamp(2rem,4.6vw,3.4rem)!important;font-weight:700;margin:.2em 0!important;line-height:1.1}
.bridge-ch{font-size:1.15rem;color:#e6ebf5}
/* hub */
.hub,.glos{padding:90px 20px 40px;background:var(--bg2)}
.hub .viz{max-width:var(--wide)}
.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin:28px 0 10px}
.gal-c{display:flex;flex-direction:column;gap:6px;text-decoration:none;color:var(--tx);background:var(--card);border-radius:18px;padding:16px;border-left:6px solid var(--c);box-shadow:var(--sh);transition:.2s}
.gal-c:hover{transform:translateY(-3px)}.gal-sec{font:800 11px var(--sans);letter-spacing:.1em;text-transform:uppercase;color:var(--c)}.gal-c b{font-size:1rem;line-height:1.3}
.cnts{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.cnt{background:var(--bg2);border-radius:18px;padding:16px;text-align:center}.cnt b{display:block;font:800 2rem var(--sans);color:var(--pk)}.cnt span{font:13px var(--sans);color:var(--mu)}
.charts{display:grid;grid-template-columns:1.3fr 1fr;gap:24px;margin-top:22px}.charts h4{margin:0 0 10px!important;font-family:var(--sans)}
.bar{display:grid;grid-template-columns:150px 1fr 70px;gap:10px;align-items:center;margin:7px 0;font:600 14px var(--sans)}
.bar.sm{grid-template-columns:150px 1fr 40px}
.bar-t{height:18px;background:var(--bg2);border-radius:999px;overflow:hidden}
.bar-f{display:block;height:100%;width:calc(var(--v)*100%);background:var(--c);border-radius:999px;transform-origin:left;transition:transform 1s cubic-bezier(.2,.8,.2,1)}
.reveal-pre .reveal:not(.in) .bar-f{transform:scaleX(0)}
.bar-n{text-align:right;color:var(--mu)}
.zp-legend{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}.zg{font:700 13px var(--sans);padding:5px 12px;border-radius:999px;color:#fff}.zg.a{background:#c2255c}.zg.b{background:#1971c2}
.zp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;align-items:start}
.zp{border-radius:18px;background:var(--bg2);border-top:5px solid var(--zc);--zc:#1971c2}.zp.a{--zc:#c2255c}
.zp summary{list-style:none;cursor:pointer;padding:16px;display:grid;grid-template-columns:44px 1fr;gap:4px 12px}
.zp summary::-webkit-details-marker{display:none}
.zp-ic{grid-row:span 3;width:44px;height:44px;border-radius:14px;background:var(--zc);display:grid;place-items:center}
.zp-ic svg{width:26px;height:26px;fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.zp-code{font:800 13px var(--sans);color:var(--zc)}[data-theme=dark] .zp-code{color:color-mix(in srgb,var(--zc) 50%,#fff)}
.zp-s{font-size:.95rem;line-height:1.4}.zp-need{font:12px var(--sans);color:var(--mu)}
.zp-more{padding:0 16px 14px;font-size:.88rem}.zp-more p{margin:.4em 0!important}
.zp[open]{box-shadow:var(--sh);background:var(--card)}
.pp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pp{display:flex;flex-direction:column;gap:4px;text-decoration:none;color:var(--tx);background:var(--bg2);border-radius:16px;padding:14px;border-left:5px solid hsl(calc(330 + var(--i)*14),55%,50%);transition:.2s}
.pp:hover{transform:translateY(-2px);box-shadow:var(--sh)}.pp-n{font:800 12px var(--sans);color:hsl(calc(330 + var(--i)*14),55%,42%)}.pp b{line-height:1.25}.pp-s{font-size:.85rem;color:var(--mu);line-height:1.4}
[data-theme=dark] .pp-n{color:hsl(calc(330 + var(--i)*14),70%,72%)}
.tl{list-style:none;margin:0;padding:0 0 0 28px;position:relative}
.tl::before{content:"";position:absolute;left:10px;top:6px;bottom:6px;width:4px;border-radius:2px;background:linear-gradient(#adb5bd,var(--pc))}
.tl-i{position:relative;margin:0 0 14px}
.tl-dot{position:absolute;left:-25px;top:14px;width:18px;height:18px;border-radius:50%;background:var(--card);border:4px solid #868e96}
.tl-i.canon .tl-dot{border-color:#f08c00;background:#ffd58a;box-shadow:0 0 0 5px rgba(240,140,0,.2)}
.tl-c{background:var(--bg2);border-radius:16px;padding:12px 16px}.tl-i.canon .tl-c{background:color-mix(in srgb,#f08c00 12%,var(--card));border:1px solid #f08c0066}
.tl-h{display:flex;gap:12px;align-items:baseline;flex-wrap:wrap;font-family:var(--sans)}.tl-h b{font-size:1.2rem}.tl-h span{color:var(--mu);font-size:13px}
.tl-st{background:#495057;color:#fff!important;padding:1px 8px;border-radius:999px;font-weight:700}.tl-i.canon .tl-st{background:#f08c00}
.tl-c p{margin:4px 0!important;font-size:.95rem}.tl-c a{font:13px var(--sans)}
/* glossary grid */
.gl-ctrl{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:20px}
.gl-q{flex:1;min-width:220px;font:16px var(--sans);padding:12px 16px;border-radius:999px;border:2px solid var(--ln);background:var(--card);color:var(--tx)}
.gl-f{display:flex;gap:6px}.gl-cnt{font:13px var(--sans);color:var(--mu)}
.gl-grid{max-width:var(--wide);margin:20px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.gc{background:var(--card);border-radius:18px;padding:16px;box-shadow:var(--sh);border-top:4px solid hsl(var(--h),55%,50%)}
.gc h4{margin:0 0 6px;font-size:1.02rem;line-height:1.3}.gc p{margin:0 0 6px;font-size:.9rem}.gc .g-role{color:var(--mu);font-size:.85rem}.gc .g-ex{font-style:italic;font-size:.85rem;color:var(--mu)}
.gl-more{display:block;margin:20px auto 0}
/* research */
.part-research{background:var(--bg)}
.rs-head{max-width:var(--wide);margin:0 auto;padding:90px 20px 10px}
.rs-kicker{font:800 13px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--mu)}
.rs-title{font-size:clamp(1.8rem,3.4vw,2.6rem);margin:.2em 0 .4em;line-height:1.15}
.rs-tabs{display:flex;gap:8px;flex-wrap:wrap;position:sticky;top:62px;z-index:5;padding:10px 0;background:var(--bg)}
.rs-tab{border-color:var(--ln);color:var(--tx);background:var(--card)}.rs-tab.on{background:#343a40;color:#fff;border-color:#343a40}
[data-theme=dark] .rs-tab.on{background:#e7e9ee;color:#111}
.js .rs-panel{display:none}.js .rs-panel.on{display:block}
/* side toc */
.toc{position:fixed;z-index:40;top:76px;left:16px;width:250px;max-height:calc(100vh - 96px);overflow:auto;font-family:var(--sans);font-size:13.5px;background:color-mix(in srgb,var(--card) 92%,transparent);backdrop-filter:blur(8px);border-radius:18px;padding:14px 10px 14px 14px;box-shadow:var(--sh);border:1px solid var(--ln);opacity:0;pointer-events:none;transform:translateX(-12px);transition:opacity .3s,transform .3s}
body.toc-show .toc{opacity:1;pointer-events:auto;transform:none}
.toc-head,.toc-menu{display:none}
.toc-pct{font-size:12px;color:var(--mu);margin-bottom:8px}
.toc-part{display:none}.toc-part.cur{display:block}
.toc-ph{display:flex;flex-direction:column;text-decoration:none;color:var(--tx);font-weight:800;border-left:5px solid var(--c);padding:2px 0 6px 10px;margin-bottom:6px}
.toc-ph span{font-weight:600;color:var(--mu);font-size:12px}
.toc ul{list-style:none;margin:0;padding:0}.toc li a{display:block;text-decoration:none;color:var(--mu);padding:4px 8px;border-radius:8px;line-height:1.3}
.toc li.t3 a{padding-left:16px}.toc li.t4 a{padding-left:26px;font-size:12.5px}
.toc li a:hover{background:var(--bg2);color:var(--tx)}
.toc li a.active{background:color-mix(in srgb,var(--c) 14%,transparent);color:var(--tx);font-weight:700;box-shadow:inset 3px 0 0 var(--c)}
@media (max-width:1359px){.toc{left:0;top:0;bottom:0;max-height:none;width:min(88vw,360px);border-radius:0 18px 18px 0;transform:translateX(-105%);opacity:1;pointer-events:auto;background:var(--card)}
body.toc-show .toc{transform:translateX(-105%)}body.toc-open .toc{transform:none}
.toc-head{display:flex;justify-content:space-between;align-items:center;font-weight:800;margin-bottom:8px}
.toc-menu{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}.toc-menu a{font-weight:700;text-decoration:none;background:var(--bg2);color:var(--tx);padding:6px 10px;border-radius:999px;font-size:13px}
.toc-part{display:block;margin-bottom:10px}}
.backdrop{position:fixed;inset:0;background:rgba(5,10,20,.45);z-index:39}
/* misc */
.foot{text-align:center;font:13px var(--sans);color:var(--mu);padding:40px 20px 60px;background:var(--bg2)}
.search{position:fixed;inset:0;z-index:80;background:rgba(5,10,20,.5);display:flex;justify-content:center;padding:10vh 12px}
.search[hidden]{display:none}
.search-box{width:min(760px,100%);max-height:76vh;display:flex;flex-direction:column;background:var(--card);border-radius:20px;box-shadow:var(--sh);overflow:hidden;font-family:var(--sans)}
.search-row{display:flex;gap:4px;padding:10px;border-bottom:1px solid var(--ln)}.search-row input{flex:1;font-size:18px;padding:10px 14px;border:0;background:var(--bg2);color:var(--tx);border-radius:12px}
.q-info{font-size:13px;color:var(--mu);padding:8px 16px}.q-res{list-style:none;margin:0;padding:0 8px 10px;overflow:auto}
.q-res li{padding:10px 12px;border-radius:12px;cursor:pointer}.q-res li:hover,.q-res li.sel{background:var(--bg2)}
.q-sec{font-size:12px;font-weight:700;color:var(--acc)}.q-snip{font-size:14px}.q-snip b{background:#ffd43b;color:#000}
.pop{position:absolute;z-index:70;max-width:min(420px,92vw);background:var(--card);color:var(--tx);border-radius:16px;padding:14px 16px;box-shadow:0 20px 50px -10px rgba(0,0,0,.4);border:1px solid var(--ln);font:14px/1.5 var(--sans)}
.pop p{margin:0 0 .5em}.pop-h{font-weight:800;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc);margin-bottom:6px}.pop-more{font-weight:700;font-size:13px}.g-role{color:var(--mu)}
.totop{position:fixed;right:18px;bottom:18px;z-index:45;width:46px;height:46px;border-radius:50%;border:0;background:var(--navy);color:#fff;font-size:20px;box-shadow:var(--sh)}
.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:75;background:var(--navy);color:#fff;border-radius:16px;padding:12px 14px 12px 18px;display:flex;gap:10px;align-items:center;font:14px var(--sans);box-shadow:var(--sh);max-width:94vw}
.toast[hidden]{display:none}.toast button{border:0;border-radius:999px;padding:6px 12px;background:#ffc860;color:#231300;font-weight:700}.toast button:last-child{background:transparent;color:#fff}
/* reveal */
.reveal{transition:opacity .7s ease,transform .7s ease}
.reveal-pre .reveal:not(.in){opacity:0;transform:translateY(24px)}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.reveal-pre .reveal:not(.in){opacity:1;transform:none}.hero-img{transform:none}.snowfall{display:none}}
/* responsive */
@media (max-width:900px){
 .five-cards,.ph-cols,.inc,.zp-grid,.pp-grid,.gl-grid,.cnts{grid-template-columns:1fr 1fr}
 .rule-row,.five-two,.mn,.ss,.u-main,.gas,.gen,.sf,.charts,.cover-meta{grid-template-columns:1fr}
 .rule-arrow{flex-direction:row;gap:10px;font-size:2rem}.rule-arrow small{max-width:none}
 .unk-cards{grid-template-columns:repeat(3,1fr)}.ord,.levels{grid-template-columns:1fr 1fr}.steps4{grid-template-columns:1fr 1fr;gap:6px}
 .steps4 li,.steps4 li:first-child{clip-path:none;border-radius:14px}
 .fam-row{grid-template-columns:1fr}.gas-t{justify-content:center}.thermo{height:120px}
 .unk-row,.hy-row{grid-template-columns:1fr}.gen-l::after{display:none}
}
@media (max-width:560px){
 :root{--fs:17.5px}
 .five-cards,.ph-cols,.inc,.zp-grid,.pp-grid,.gl-grid,.cnts,.ord,.levels{grid-template-columns:1fr}
 .unk-cards{grid-template-columns:1fr 1fr}.unk-card{min-height:0}
 .cover{min-height:88vh}.cover-in{padding:100px 18px 36px}.cover-stats{grid-template-columns:repeat(4,1fr);gap:6px}.cover-stats b{font-size:1.15rem}
 .viz{padding:22px 16px 14px;border-radius:22px}.part-body{padding:28px 16px 60px}
 .five,.route,.hub,.glos{padding-left:16px;padding-right:16px}
 .ph-cols{margin-top:12px;padding:0}.bar,.bar.sm{grid-template-columns:110px 1fr 54px;font-size:12.5px}
 .pull{padding-left:44px}.pull-mark{font-size:72px}.pull p{font-size:1.25rem!important}
 .hero-in{padding:0 20px 14vh}.box{padding-left:54px!important}
 .gl-f{flex-wrap:wrap}
}
@media print{.topbar,.toc,.hero,.five,.route,.hub,.glos,.cover,.viz,.pull,.bridge,#progress,.totop,.rs-tabs{display:none!important}.rs-panel{display:block!important}.table-wrap.tw-big.clamped{max-height:none}body{background:#fff;color:#000}}

html{overflow-x:hidden}body{overflow-x:clip}
.part-body p,.part-body li,.part-body td,.fn-list li,.rs-panel p{overflow-wrap:break-word}
.part-body a,.rs-panel a,.fn-list a{overflow-wrap:anywhere}
.unk-card{min-width:0}.unk-t{overflow-wrap:anywhere;hyphens:auto}
.cv-l{list-style:none;margin:0;padding:0}.cv-l li{margin:.25em 0}
@media (min-width:1360px){.part-body>.docsec>.wide,.part-body>.docsec>.table-wrap,.part-body>.docsec>.bridge{max-width:min(var(--wide),calc(100vw - 580px))}}
@media (min-width:901px){.bridge{align-items:center}.bridge-img{width:130%;left:0;right:auto}
.bridge-in{max-width:56%;background:linear-gradient(90deg,rgba(5,8,18,.92) 0%,rgba(5,8,18,.75) 75%,rgba(5,8,18,0));padding:48px 40px;align-self:stretch;display:flex;flex-direction:column;justify-content:center}}
/* ================= v3 ================= */
.metro-net .legend text{font-size:19px!important;font-weight:700}.metro-net text.sm{font-size:15px}
.fig-n{font:800 .82em var(--sans);color:var(--pk);letter-spacing:.02em}
.viz-src .fig-n{color:var(--pk)}
.viz-hyp{display:inline-block;margin:0 0 10px}
.gen-tag{position:absolute;left:10px;top:10px;font:800 10.5px var(--sans);letter-spacing:.08em;text-transform:uppercase;background:rgba(10,16,30,.72);color:#fff;padding:3px 8px;border-radius:999px;z-index:2}
.gen-tag.ph{background:rgba(255,255,255,.85);color:#111}
.ph-img,.ss-img,.inc-c{position:relative}
/* photos */
.photo{margin:2.2em auto!important;position:relative}
.part-body>.docsec>.photo.wide{max-width:var(--wide)}
.part-body>.docsec>.photo.narrow{max-width:calc(var(--col) * .72)}
.photo .ph-frame{border-radius:22px;overflow:hidden;box-shadow:0 22px 50px -24px rgba(20,30,60,.45);background:var(--bg2)}
.photo img{display:block;width:100%;height:auto}
.photo.wide img{max-height:78vh;object-fit:cover}
.photo figcaption{font:14px/1.5 var(--sans);color:var(--mu);margin-top:10px;padding-left:14px;border-left:4px solid var(--pc)}
.photo figcaption .fig-n{margin-right:4px}
.credit{display:block;font-size:12.5px;opacity:.9;margin-top:2px}
.credit a{color:inherit}
.cover-credit{position:absolute;right:14px;bottom:10px;z-index:3;font:11.5px var(--sans);color:rgba(255,255,255,.82);text-shadow:0 1px 3px #000;max-width:60%;text-align:right}
.cover-credit .credit{font-size:11.5px}.cover-credit a{color:#fff}
.bridge .credit{position:absolute;right:14px;bottom:10px;z-index:3;color:rgba(255,255,255,.8);font:11.5px var(--sans)}.bridge .credit a{color:#fff}
/* generic pieces */
.qc{background:color-mix(in srgb,var(--pc) 7%,var(--card));border:1px solid color-mix(in srgb,var(--pc) 25%,var(--ln));border-radius:16px;padding:12px 16px}
.qc p{margin:0!important;font-size:.98rem}.qc.big p{font-size:1.2rem;font-weight:700}.qc.hot{background:color-mix(in srgb,#e8590c 12%,var(--card));border-color:color-mix(in srgb,#e8590c 45%,var(--ln))}
.flow{list-style:none;padding:0;margin:0;display:grid;gap:12px;counter-reset:f}
.flow.h{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.flow li{position:relative;background:color-mix(in srgb,var(--pc) calc(8% + var(--i)*6%),var(--card));border-radius:16px;padding:14px 16px 14px 16px;border:1px solid color-mix(in srgb,var(--pc) 30%,var(--ln))}
.flow li div{font-size:.98rem;line-height:1.45}
.flow.h li:not(:last-child)::after{content:"→";position:absolute;right:-13px;top:50%;transform:translateY(-50%);z-index:2;width:24px;height:24px;border-radius:50%;background:var(--pc);color:#fff;display:grid;place-items:center;font:800 14px var(--sans)}
.flow.v li:not(:last-child)::after{content:"↓";position:absolute;left:50%;bottom:-15px;transform:translateX(-50%);z-index:2;width:22px;height:22px;border-radius:50%;background:var(--pc);color:#fff;display:grid;place-items:center;font:800 13px var(--sans)}
.fl-n{display:inline-block;font:800 12px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:#fff;background:var(--pc);border-radius:999px;padding:3px 10px;margin-bottom:8px}
.flow.big li{padding:20px}.flow.big .fl-n{font-size:14px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:22px}.two h4,.tcol h4{margin:0 0 10px!important;font:800 1rem var(--sans)}
.warnrow{display:flex;gap:12px;align-items:flex-start;margin-top:14px;background:color-mix(in srgb,#f59f00 12%,var(--card));border-radius:14px;padding:12px 16px;border:1px solid color-mix(in srgb,#f59f00 40%,var(--ln))}
.warnrow p{margin:0!important;font-size:.95rem}.wr-ic{font-size:1.3rem}
/* portrait quad */
.quad{display:grid;grid-template-columns:1fr 1fr;grid-template-areas:"a b" "c c" "d e";gap:12px;align-items:stretch}
@media(min-width:760px){.quad{grid-template-columns:1fr 220px 1fr;grid-template-areas:"a c b" "d c e"}}
.quad-c{grid-area:c;position:relative;border-radius:50%/40%;overflow:hidden;min-height:220px;box-shadow:var(--sh)}
.quad-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.quad-c span{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);font:800 11px var(--sans);text-transform:uppercase;letter-spacing:.1em;background:rgba(0,0,0,.6);color:#fff;padding:3px 10px;border-radius:999px;white-space:nowrap}
.quad-q{background:var(--bg2);border-radius:16px;padding:12px 14px;border-top:4px solid var(--pc)}.quad-q p{margin:0!important;font-size:.95rem}
.quad-q.q0{grid-area:a}.quad-q.q1{grid-area:b}.quad-q.q2{grid-area:d}.quad-q.q3{grid-area:e;border-top-color:#c2255c}
/* passport flow */
.pflow{display:grid;grid-template-columns:1fr auto 1.3fr auto 1fr;gap:10px;align-items:center}
.pf-a,.pf-pass,.pf-ok,.pf-no{border-radius:16px;padding:14px}.pf-a{background:color-mix(in srgb,#2b8a3e 12%,var(--card));border:1px solid color-mix(in srgb,#2b8a3e 40%,var(--ln))}
.pf-a b{font-family:var(--sans)}.pf-a p,.pf-ok p,.pf-no p{margin:6px 0 0!important;font-size:.92rem}
.pf-arr{font:800 14px var(--sans);color:var(--pk);text-align:center}.ar{display:inline-block}
.pf-pass{background:var(--pc);color:#fff}.pf-pass .ss-k{color:rgba(255,255,255,.85)}.pf-pass ol{margin:0;padding-left:1.2em}.pf-pass li{margin:.2em 0;font-weight:700}
.pf-out{display:grid;gap:10px}.pf-ok{background:color-mix(in srgb,#2b8a3e 12%,var(--card))}.pf-no{background:color-mix(in srgb,#c92a2a 10%,var(--card))}
@media(max-width:820px){.pflow{grid-template-columns:1fr}.pf-arr .ar{transform:rotate(90deg)}}
.pp8{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
.pp8-c{background:color-mix(in srgb,var(--pc) calc(4% + var(--i)*2.4%),var(--card));border-radius:16px;padding:14px;border:1px solid var(--ln);position:relative}
.pp8-c h4{margin:0 0 6px!important;font:800 .95rem var(--sans);color:var(--pk)}.pp8-c p{margin:0!important;font-size:.92rem}
.pp8-n{position:absolute;right:12px;top:10px;font:900 1.6rem var(--sans);color:color-mix(in srgb,var(--pc) 40%,transparent)}
/* venn */
.venn-w{display:grid;grid-template-columns:1.1fr 1fr;gap:18px;align-items:center}
.venn{width:100%;height:auto}.vc{stroke-width:3}.vc.a{fill:rgba(28,126,214,.22);stroke:#1c7ed6}.vc.b{fill:rgba(12,166,120,.2);stroke:#0ca678}
.vt{font:800 24px var(--sans);text-anchor:middle;fill:var(--tx)}.vt.sm{font-size:19px}.vs{font:600 16px var(--sans);text-anchor:middle;fill:var(--mu)}
.venn-side{display:grid;gap:10px}
.four4{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.four4 span{font:700 13px var(--sans);padding:6px 12px;border-radius:999px;background:var(--pc);color:#fff}
@media(max-width:720px){.venn-w,.two{grid-template-columns:1fr}}
/* tree */
.tree{display:grid;gap:14px}.tr-root{justify-self:center;text-align:center;background:var(--pc);color:#fff;border-radius:18px;padding:12px 22px}.tr-root b{font-size:1.3rem;display:block}.tr-root span{font-size:.9rem;opacity:.9}
.tr-kids{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative;padding-top:18px}
.tr-kids::before{content:"";position:absolute;top:0;left:12.5%;right:12.5%;height:14px;border:3px solid color-mix(in srgb,var(--pc) 50%,transparent);border-bottom:0;border-radius:12px 12px 0 0}
.tr-k{background:color-mix(in srgb,var(--pc) calc(8% + var(--i)*5%),var(--card));border-radius:16px;padding:12px;border:1px solid var(--ln)}
.tr-k b{display:block;font:800 .9rem var(--sans);margin:4px 0}.tr-k p{margin:0!important;font-size:.88rem}
.tr-sym{display:inline-grid;place-items:center;min-width:44px;height:44px;padding:0 8px;border-radius:12px;background:var(--card);border:2px solid var(--pc);font:700 1.25rem "Cambria Math","STIX Two Math",var(--serif);color:var(--pk)}
.tr-crit{display:flex;gap:12px;align-items:center;background:var(--bg2);border-radius:16px;padding:10px 14px}.tr-crit p{margin:0!important;font-size:.95rem}
@media(max-width:820px){.tr-kids{grid-template-columns:1fr 1fr}.tr-kids::before{display:none}}
/* versus */
.vs2{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:stretch}
.vs-c{border-radius:18px;padding:16px;position:relative}.vs-c h4{margin:6px 0 8px!important;font:800 1.02rem var(--sans)}.vs-c p{margin:0 0 .5em!important;font-size:.95rem}
.vs-c.a,.vs-c.ok{background:color-mix(in srgb,#2b8a3e 11%,var(--card));border:1px solid color-mix(in srgb,#2b8a3e 35%,var(--ln))}
.vs-c.b{background:color-mix(in srgb,#5f3dc4 10%,var(--card));border:1px solid color-mix(in srgb,#5f3dc4 35%,var(--ln))}
.vs-c.no{background:color-mix(in srgb,#c92a2a 9%,var(--card));border:1px solid color-mix(in srgb,#c92a2a 35%,var(--ln))}
.vs-ic{font-size:1.6rem}.vs-mid{align-self:center;font:900 2rem var(--sans);color:var(--pk)}
.vs-tag{display:inline-block;font:800 11px var(--sans);text-transform:uppercase;letter-spacing:.06em;background:rgba(0,0,0,.08);padding:3px 9px;border-radius:999px}
@media(max-width:720px){.vs2{grid-template-columns:1fr}.vs-mid{justify-self:center}}
/* doctor roles */
.roles{display:grid;gap:12px}.rl-op{display:flex;gap:12px;align-items:center;background:var(--pc);color:#fff;border-radius:16px;padding:12px 16px}.rl-op p{margin:0!important}.rl-op .tr-sym{background:#fff}
.rl-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.rl-c{border-radius:16px;padding:12px;border:1px solid var(--ln)}.rl-c h4{margin:6px 0!important;font:800 .9rem var(--sans);text-transform:uppercase;letter-spacing:.06em}.rl-c p{margin:0!important;font-size:.9rem}
.rl-c.r0{background:color-mix(in srgb,#e8590c 14%,var(--card))}.rl-c.r1{background:color-mix(in srgb,#868e96 14%,var(--card))}.rl-c.r2{background:color-mix(in srgb,#1c7ed6 12%,var(--card))}.rl-c.r3{background:color-mix(in srgb,#2b8a3e 12%,var(--card))}
@media(max-width:820px){.rl-grid{grid-template-columns:1fr 1fr}}
/* trace */
.trace{display:grid;gap:14px}.tr-def{font-size:1rem;background:var(--bg2);border-radius:14px;padding:12px 16px;border-left:5px solid var(--pc)}
.tr-fork{display:grid;grid-template-columns:90px 1fr;gap:14px;align-items:center}
.tf-from{width:84px;height:84px;border-radius:50%;display:grid;place-items:center;background:var(--pc);color:#fff;font:700 2rem "Cambria Math",var(--serif)}
.tf-br{display:grid;gap:10px}.tf-b{display:grid;grid-template-columns:auto auto 1fr;gap:12px;align-items:center;border-radius:14px;padding:10px 14px}
.tf-b span{font:700 14px var(--sans)}.tf-b b{font:700 1.4rem "Cambria Math",var(--serif)}.tf-b small{font:600 13px var(--sans);color:var(--mu)}
.tf-b.ok{background:color-mix(in srgb,#2b8a3e 13%,var(--card))}.tf-b.no{background:color-mix(in srgb,#c92a2a 9%,var(--card))}
.tr-car{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.car{background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:12px}.car p{margin:6px 0 0!important;font-size:.9rem}.car.hy{border-style:dashed;border-color:#7048e8}
@media(max-width:720px){.tr-car{grid-template-columns:1fr}.tr-fork{grid-template-columns:1fr}.tf-b{grid-template-columns:1fr}}
/* cost cards */
.cost{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.cost-c{border-radius:18px;padding:16px;background:color-mix(in srgb,var(--pc) calc(7% + var(--i)*6%),var(--card));border:1px solid var(--ln)}
.cost-ic{font-size:1.8rem;display:block;margin-bottom:4px}.cost-c h4{margin:0 0 6px!important;font:800 1rem var(--sans)}.cost-c p{margin:0 0 .4em!important;font-size:.95rem}
/* chart */
.chart{overflow-x:auto}.desi{width:100%;min-width:560px;height:auto}
.desi .grid{stroke:var(--ln);stroke-width:1}.desi .zero{stroke:var(--tx);stroke-width:2;stroke-dasharray:5 4}.desi .ax{font:600 14px var(--sans);fill:var(--mu);text-anchor:middle}.desi .ax.t{font-weight:700}
.desi .lab{font:700 14px var(--sans);fill:var(--tx);text-anchor:end}.desi .eb{stroke:var(--tx);stroke-width:3;stroke-linecap:round}.desi .val{font:800 14px var(--sans);fill:var(--pk);text-anchor:middle}
.desi .pt{stroke:#fff;stroke-width:2}.desi .p0{fill:#1c7ed6}.desi .p1{fill:#0ca678}.desi .p2{fill:#e8590c}
/* stairs */
.stairs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;align-items:end}
.st-s{display:block;text-decoration:none;color:var(--tx);border-radius:16px 16px 6px 6px;padding:14px;background:color-mix(in srgb,var(--pc) calc(12% + var(--i)*14%),var(--card));min-height:calc(90px + var(--i)*34px);border:1px solid var(--ln)}
.st-s b{display:block;font:800 .95rem var(--sans);margin-top:4px}.st-s p{margin:6px 0 0!important;font-size:.88rem}
.st-n{font:900 1.5rem var(--sans);color:var(--pk)}
.stairs.q .st-s{min-height:calc(130px + var(--i)*30px)}
.st-notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-top:12px}
@media(max-width:720px){.stairs{grid-template-columns:1fr 1fr}.st-s{min-height:0!important}}
/* timeline III */
.tlx{overflow-x:auto;padding:6px 2px 10px}
.tlx-line{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:30px 10px;position:relative;padding-top:24px}
.tlx-line::before{display:none}.tlx-i{border-top:4px solid #adb5bd}.tlx-i.core{border-top-color:var(--pc)}
.tlx-i{position:relative;display:block;text-decoration:none;color:var(--tx);background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:10px 12px}
.tlx-i::before{content:"";position:absolute;top:-22px;left:16px;width:14px;height:14px;border-radius:50%;background:#adb5bd;border:3px solid var(--card)}
.tlx-i.core{background:color-mix(in srgb,var(--pc) 12%,var(--card));border-color:color-mix(in srgb,var(--pc) 45%,var(--ln))}.tlx-i.core::before{background:var(--pc)}
.tlx-y{display:block;font:900 1.2rem var(--sans);color:var(--pk)}.tlx-i b{display:block;font:800 .95rem var(--sans)}.tlx-w{display:block;font-size:.8rem;color:var(--mu);line-height:1.3;margin-top:3px}
.tlx-leg{display:flex;gap:16px;flex-wrap:wrap;font:13px var(--sans);color:var(--mu);margin-top:6px}.tlx-leg span::before{content:"●";margin-right:6px;color:#adb5bd}.tlx-leg span.core::before{color:var(--pc)}
/* matrix */
.mx{display:grid;gap:8px}.mx-h,.mx-r{display:grid;grid-template-columns:150px 1fr 1fr;gap:10px}
.mx-h span{font:800 12px var(--sans);letter-spacing:.08em;text-transform:uppercase;padding:0 6px}.mx-h .g{color:#2b8a3e}.mx-h .r{color:#c2255c}
.mx-n{font:800 .95rem var(--sans);color:#fff;background:var(--pc);border-radius:14px;padding:12px;text-decoration:none;display:flex;align-items:center}
.mx-c{border-radius:14px;padding:10px 12px;font-size:.9rem;line-height:1.45}.mx-c.g{background:color-mix(in srgb,#2b8a3e 10%,var(--card));border:1px solid color-mix(in srgb,#2b8a3e 30%,var(--ln))}
.mx-c.r{background:color-mix(in srgb,#c2255c 8%,var(--card));border:1px solid color-mix(in srgb,#c2255c 28%,var(--ln))}
@media(max-width:760px){.mx-h{display:none}.mx-r{grid-template-columns:1fr}.mx-c.g::before{content:"Общее: ";font-weight:800;color:#2b8a3e}.mx-c.r::before{content:"Различие: ";font-weight:800;color:#c2255c}}
/* fork */
.fork{display:grid;grid-template-columns:170px 1fr;gap:16px;align-items:center}
.fk-root{background:var(--pc);color:#fff;border-radius:20px;padding:18px;text-align:center;font-family:var(--sans)}.fk-root b{font-size:1.2rem}
.fk-br{display:grid;gap:8px;border-left:4px solid color-mix(in srgb,var(--pc) 50%,transparent);padding-left:14px}
.fk-b{background:color-mix(in srgb,var(--pc) calc(6% + var(--i)*5%),var(--card));border-radius:14px;padding:10px 14px;position:relative}
.fk-b::before{content:"";position:absolute;left:-18px;top:50%;width:14px;height:4px;background:color-mix(in srgb,var(--pc) 50%,transparent)}
.fk-b p{margin:0!important;font-size:.92rem}
@media(max-width:720px){.fork{grid-template-columns:1fr}}
/* pair matrix */
.pm-body{display:grid;grid-template-columns:minmax(0,1.3fr) 1fr;gap:20px;align-items:center;margin-top:12px}
.pm-svg{width:100%;height:auto}.pm-l{font:700 12px var(--sans);fill:var(--mu);text-anchor:middle}
.pm-svg rect.u{fill:var(--bg2)}.pm-svg rect.m{fill:#e03131;transition:fill .35s}
.pm[data-s="1"] rect.m.b,.pm[data-s="2"] rect.m.c,.pm[data-s="3"] rect.m.b,.pm[data-s="3"] rect.m.c{fill:#2f9e44}
.pm-grp{fill:none;stroke:var(--pc);stroke-width:2.5;stroke-dasharray:6 4}
.pm-big{font:800 1.1rem var(--sans)}.pm-n{font-size:3rem;color:#2f9e44}.pm-u{font:800 1.4rem var(--sans);margin:4px 0 10px}
.pm-leg{list-style:none;padding:0;margin:0 0 10px;font:13px var(--sans)}.pm-leg li{display:flex;gap:8px;align-items:center;margin:4px 0}.pm-leg i{width:16px;height:16px;border-radius:4px;display:inline-block}
.pm-leg i.m{background:#e03131}.pm-leg i.s{background:#2f9e44}.pm-leg i.u{background:var(--bg2);border:1px solid var(--ln)}
.pm-txt{font-size:.95rem;margin:0!important}
@media(max-width:760px){.pm-body{grid-template-columns:1fr}}
/* U bars */
.ubars{display:grid;gap:12px}.ub{display:grid;grid-template-columns:190px 1fr 120px;gap:12px;align-items:center}
.ub-l{font:700 14px var(--sans)}.ub-t{height:26px;background:var(--bg2);border-radius:999px;overflow:hidden}
.ub-f{display:block;height:100%;width:calc(var(--v)*100%);background:linear-gradient(90deg,var(--pc),#f08c00);border-radius:999px;min-width:4px}
.ub.metro .ub-f{background:linear-gradient(90deg,#e8590c,#1c7ed6)}
.ub-v{font:800 14px var(--sans);color:var(--pk)}.ub-g{grid-column:2/4;font:12.5px var(--sans);color:var(--mu);margin-top:-6px}
.ub-na{margin-top:12px;font:14px var(--sans);background:var(--bg2);border-radius:12px;padding:8px 12px}
@media(max-width:640px){.ub{grid-template-columns:1fr auto}.ub-t{grid-column:1/3;grid-row:2}.ub-g{grid-column:1/3}}
/* image -> metric */
.i2m-h{display:grid;grid-template-columns:1.2fr 30px 1fr 30px 1fr;gap:8px;font:800 11px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--mu);margin-bottom:6px}
.i2m{display:grid;gap:8px}.i2m-r{display:grid;grid-template-columns:1.2fr 30px 1fr 30px 1fr;gap:8px;align-items:stretch}
.i2m-a,.i2m-b,.i2m-c{border-radius:14px;padding:10px 12px;font-size:.9rem}
.i2m-a{background:color-mix(in srgb,var(--pc) 10%,var(--card));border:1px solid var(--ln)}.i2m-a b{display:block;font-family:var(--sans)}.i2m-a span{color:var(--mu);font-size:.86rem}
.i2m-b{background:var(--pc);color:#fff;font-weight:700}.i2m-c{background:var(--bg2);font:700 .88rem var(--sans)}
.i2m-ar{align-self:center;text-align:center;font:900 1.2rem var(--sans);color:var(--pk)}
@media(max-width:760px){.i2m-h{display:none}.i2m-r{grid-template-columns:1fr}.i2m-ar{transform:rotate(90deg)}}
/* obermeyer */
.obm{display:grid;gap:10px;margin-bottom:12px}.obm-row{display:grid;grid-template-columns:200px 1fr auto 1fr;gap:10px;align-items:center}
.obm-src{font:800 12px var(--sans);text-transform:uppercase;letter-spacing:.06em;color:var(--mu)}
.obm-x,.obm-y{border-radius:14px;padding:12px;font-family:var(--sans)}.obm-x{background:var(--bg2)}.obm-y{background:color-mix(in srgb,#c92a2a 12%,var(--card));border:2px dashed #c92a2a}
.obm-ar{font:800 13px var(--sans);color:#c92a2a}
@media(max-width:760px){.obm-row{grid-template-columns:1fr}}
/* protocol */
.proto{display:grid;gap:12px}.pr-arms{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:stretch}
.pr-arm{border-radius:16px;padding:14px;color:#fff}.pr-arm.a{background:#2b8a3e}.pr-arm.b{background:#495057}.pr-arm .ss-k{color:rgba(255,255,255,.8)}.pr-arm b{font-size:1.1rem}.pr-arm p{margin:6px 0 0!important;font-size:.92rem}
.pr-vs{align-self:center;font:900 1.4rem var(--sans);color:var(--mu)}
.pr-eq{text-align:center;font:700 14px var(--sans);background:var(--bg2);border-radius:999px;padding:8px 14px}
.pr-m{border:2px solid var(--pc);border-radius:16px;padding:12px 14px}.pr-m p{margin:0 0 .3em!important}
.pr-out{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.pr-o{border-radius:14px;padding:12px}.pr-o p{margin:0!important;font-size:.9rem}
.pr-o.ok{background:color-mix(in srgb,#2b8a3e 11%,var(--card))}.pr-o.no{background:color-mix(in srgb,#c92a2a 10%,var(--card))}.pr-o.un{background:color-mix(in srgb,#f59f00 13%,var(--card))}
@media(max-width:760px){.pr-arms,.pr-out{grid-template-columns:1fr}.pr-vs{justify-self:center}}
/* silberzahn */
.sz{display:grid;grid-template-columns:1fr auto 160px;gap:16px;align-items:center}
.sz-teams{display:grid;grid-template-columns:repeat(10,1fr);gap:6px}.sz-t{aspect-ratio:1;border-radius:50%;background:hsl(calc(150 + var(--i)*7),55%,48%)}
.sz-arrow{font:900 2rem var(--sans);color:var(--pk)}.sz-data{background:var(--pc);color:#fff;border-radius:18px;padding:16px;text-align:center;font-family:var(--sans)}.sz-data b{font-size:2.4rem;display:block}
@media(max-width:640px){.sz{grid-template-columns:1fr}.sz-arrow{transform:rotate(90deg);justify-self:center}}
/* trace types */
.ttyp{display:grid;grid-template-columns:220px 1fr;gap:14px;align-items:center}
.tt-ex{background:#1d2129;color:#fff;border-radius:16px;padding:16px;font-family:var(--sans)}.tt-ex .ss-k{color:#adb5bd}.tt-ex p{margin:8px 0 0!important;font-family:ui-monospace,monospace;background:#343a40;border-radius:8px;padding:6px 8px;font-size:.9rem}
.tt-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tt-c{border-radius:14px;padding:12px;border:1px solid var(--ln)}.tt-c h4{margin:6px 0!important;font:800 .9rem var(--sans)}.tt-c p{margin:0!important;font-size:.9rem}
.tt-c.on{background:color-mix(in srgb,#2b8a3e 10%,var(--card))}.tt-c.off{background:var(--bg2);opacity:.85;border-style:dashed}
@media(max-width:760px){.ttyp,.tt-grid{grid-template-columns:1fr}}
/* registers */
.reg{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px}
.reg-c{text-decoration:none;color:var(--tx);border-radius:16px;padding:14px;background:hsl(calc(200 + var(--i)*24),70%,95%);border:1px solid var(--ln);display:block}
[data-theme=dark] .reg-c{background:hsl(calc(200 + var(--i)*24),30%,18%)}
.reg-n{font:900 1.4rem var(--sans);color:hsl(calc(200 + var(--i)*24),60%,40%)}.reg-c b{display:block;font:800 .95rem var(--sans);margin:2px 0 6px}.reg-c p{margin:0!important;font-size:.88rem}
[data-theme=dark] .reg-n{color:hsl(calc(200 + var(--i)*24),70%,70%)}
/* summary card */
.sumcard{max-width:var(--col);margin:2em auto!important;border-radius:22px;padding:18px 22px 14px;background:linear-gradient(135deg,color-mix(in srgb,var(--pc) 13%,var(--card)),var(--card) 70%);border:2px solid color-mix(in srgb,var(--pc) 45%,var(--ln));box-shadow:var(--sh)}
.sum-k{font:800 12px var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--pk);display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.sum-ic{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--pc);color:#fff;font-size:13px}
.sumcard ul{margin:.7em 0 .5em;padding-left:1.1em}.sumcard li{margin:.35em 0;font-size:1rem;line-height:1.5}.sumcard li::marker{color:var(--pc)}
.sum-f{font:12.5px var(--sans);color:var(--mu);border-top:1px solid var(--ln);padding-top:8px;display:flex;gap:6px;flex-wrap:wrap;align-items:baseline}.sum-f>a:last-child{margin-left:auto}
/* gallery */
.gal-f{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.gal-f button{border:1px solid var(--ln);background:var(--card);border-radius:999px;padding:8px 14px;font:700 14px var(--sans);color:var(--tx);cursor:pointer}
.gal-f button.on{background:#d9480f;border-color:#d9480f;color:#fff}.gal-c[hidden]{display:none}
.gal-sec b{font-weight:900}
/* credits page */
.credits{padding:90px 20px 60px;background:var(--bg)}
.cr-list{max-width:var(--wide);margin:24px auto;padding:0;list-style:none;display:grid;gap:12px}
.cr,.cr-gen li{display:grid;grid-template-columns:150px 1fr;gap:16px;background:var(--card);border:1px solid var(--ln);border-radius:16px;padding:12px;align-items:start}
.cr img,.cr-gen img{width:150px;height:100px;object-fit:cover;border-radius:10px}
.cr b,.cr-gen b{font:800 1rem var(--sans)}.cr p,.cr-gen p{margin:4px 0 0;font:13.5px/1.5 var(--sans);color:var(--mu)}.cr-w{color:var(--pk)!important;font-weight:700!important}
.cr-h{max-width:var(--wide);margin:30px auto 10px;font:800 1.3rem var(--sans)}.cr-gen{max-width:var(--wide);margin:0 auto;padding:0;list-style:none;display:grid;gap:12px}
@media(max-width:600px){.cr,.cr-gen li{grid-template-columns:1fr}.cr img,.cr-gen img{width:100%;height:160px}}
/* tables: icon, captions, cards on phones */
.tcap{font:800 .92rem var(--sans)!important;color:var(--pk);display:flex;gap:10px;align-items:center;margin-top:1.6em!important}
.tcap::before{content:"▦";display:inline-grid;place-items:center;width:30px;height:30px;border-radius:9px;background:var(--pc);color:#fff;font-size:16px;flex:none}
.table-wrap{border-top:5px solid var(--pc)}
.table-wrap tr:hover>td{background:color-mix(in srgb,var(--pc) 10%,var(--card))}
@media(max-width:640px){
 .table-wrap{overflow:visible;box-shadow:none;border:0;background:transparent;border-top:0}
 .table-wrap table.cardable,.table-wrap table.cardable tbody,.table-wrap table.cardable tr,.table-wrap table.cardable td{display:block;width:100%}
 .table-wrap table.cardable tr:first-child{display:none}
 .table-wrap table.cardable tr{background:var(--card);border:1px solid var(--ln);border-left:5px solid var(--pc);border-radius:14px;margin:0 0 12px;box-shadow:var(--sh);overflow:hidden}
 .table-wrap table.cardable td{border:0;border-bottom:1px solid var(--ln);background:transparent!important;padding:8px 12px}
 .table-wrap table.cardable td:last-child{border-bottom:0}
 .table-wrap table.cardable td[data-label]::before{content:attr(data-label);display:block;font:800 10.5px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--pk);margin-bottom:2px}
 .table-wrap table.cardable td:first-child{background:color-mix(in srgb,var(--pc) 9%,var(--card))!important;font-weight:700}
 .table-wrap.tw-big.clamped{max-height:640px}
 .flow.h li:not(:last-child)::after{content:"↓";right:auto;left:50%;top:auto;bottom:-15px;transform:translateX(-50%)}
 .flow.h{grid-template-columns:1fr}
}

/* ===== v3.1: Δ̂ hat, robustness, no-JS fallback ===== */
.dhat{position:relative;display:inline-block;white-space:nowrap}.dhat .cmb{font-size:0;line-height:0}
.dhat::after{content:"";position:absolute;left:50%;top:.09em;width:.2em;height:.2em;border-left:.075em solid currentColor;border-top:.075em solid currentColor;transform:translateX(-50%) rotate(45deg);pointer-events:none}
.tr-sym{display:inline-flex!important;align-items:center;justify-content:center;white-space:nowrap}
@media(max-width:720px){.vs-mid .ar{transform:rotate(90deg)}}
/* without JavaScript (or if the script failed): everything readable, plain anchors */
html:not(.js) .tools,html:not(.js) .rs-tabs,html:not(.js) .tw-btn,html:not(.js) .gl-ctrl,html:not(.js) .gal-f,html:not(.js) .pm-tabs,html:not(.js) #btn-resume,html:not(.js) .toc-head,html:not(.js) .toc-pct,html:not(.js) .backdrop{display:none!important}
html:not(.js) .rule-ex[hidden]{display:block}
html:not(.js) .menu{display:flex!important;overflow-x:auto;flex-wrap:nowrap;-webkit-overflow-scrolling:touch}
html:not(.js) .toc{position:static!important;opacity:1!important;pointer-events:auto!important;transform:none!important;width:auto!important;max-width:var(--wide);max-height:none!important;margin:30px auto;border-radius:18px!important;background:var(--card)!important}
html:not(.js) .toc-menu{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
html:not(.js) .toc-menu a{font-weight:700;text-decoration:none;background:var(--bg2);color:var(--tx);padding:6px 10px;border-radius:999px;font-size:13px}
html:not(.js) .toc-part,html:not(.js) .toc-part ul{display:block!important}
html:not(.js) .toc-part{margin-bottom:12px}
/* v3.1: the drawer TOC exists up to 1359px, so the burger must be available there too */
@media (max-width:1359px){#btn-menu{display:inline-grid}}
/* v3.1: topbar never pushes the tools off-screen */
.topbar{min-width:0}.brand{flex:none}.tools{flex:none}
.menu{min-width:0;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}.menu::-webkit-scrollbar{display:none}
@media (max-width:1359px){.brand-s,.tools .hide-s{display:none}}
@media (max-width:1560px){.menu>a[data-nav=top],.mp-l,.brand-s{display:none}}
@media (max-width:1300px){.menu>a{padding:7px 7px;font-size:14px}.menu-parts{padding:0 2px;gap:3px}}
@media (max-width:1200px){.menu{display:none}.tools{margin-left:auto}}
/* ================= v4: figure ↔ paragraph link, two-part captions, mini-visuals ================= */
[data-anchor]{box-shadow:inset 3px 0 0 color-mix(in srgb,var(--pc) 70%,transparent);padding-left:14px;border-radius:2px}
ul[data-anchor],ol[data-anchor]{padding-left:calc(1.4em + 14px)}
.figrefs{white-space:nowrap}
.figref{display:inline-block;margin-left:.35em;font:700 12.5px/1.6 var(--sans);color:var(--pk)!important;background:color-mix(in srgb,var(--pc) 10%,var(--card));border:1px solid color-mix(in srgb,var(--pc) 35%,transparent);border-radius:999px;padding:0 .6em;text-decoration:none!important;vertical-align:.1em}
.figref+.figref{margin-left:.25em}
.figref:hover,.figref:focus-visible{background:var(--pc);color:#fff!important}
.figrefs-after{margin:-.4em auto .4em!important;text-align:right}
.cap2{display:block;margin:.35em 0 .2em}
.cap2 .c2{margin:.2em 0;font:14px/1.5 var(--sans);color:var(--tx)}
.cap2 .c2 b{color:var(--pk);font-weight:800}
.cap2 .c2-h{color:var(--mu)}
.viz .cap2{padding:12px 16px;border-radius:12px;background:color-mix(in srgb,var(--pc) 6%,var(--card));border-left:4px solid var(--pc);margin:16px 0 8px}
.photo figcaption .cap2{margin-top:.2em}
.bridge-cap{margin-top:18px;font:13.5px/1.5 var(--sans);color:rgba(255,255,255,.88)}
.bridge-cap .cap2 .c2{color:rgba(255,255,255,.9)}.bridge-cap .cap2 .c2 b,.bridge-cap .fig-n{color:#ffd8a8}
[data-theme=dark] .cap2 .c2 b{color:color-mix(in srgb,var(--pc) 55%,#fff)}
/* mini visuals */
.mini4 .viz-title{font-size:clamp(1.12rem,2.2vw,1.38rem)}
.fx4{background:var(--card);border:1px solid var(--ln);border-radius:16px;padding:18px 18px 12px;margin:6px 0 12px}
.fx4-e{font:600 clamp(1.05rem,2.6vw,1.45rem)/1.4 var(--serif);text-align:center;padding:6px 4px 14px;border-bottom:1px dashed var(--ln);overflow-wrap:anywhere}
.fx4-e i{font-style:italic;color:var(--pk)}.fx4-e i.chg,.fx4-l i.chg{color:#c2255c}
.fx4-x{color:#c2255c;margin:0 .25em}
.fx4-l{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:8px 14px;margin:12px 0 4px}
.fx4-l>div{display:flex;gap:10px;align-items:baseline;min-width:0}
.fx4-l dt{flex:none;min-width:2.6em;text-align:center;font:700 1.02rem var(--serif);background:color-mix(in srgb,var(--pc) 12%,var(--card));border-radius:8px;padding:2px 8px;color:var(--pk)}
.fx4-l dd{margin:0;font:14.5px/1.45 var(--sans);min-width:0;overflow-wrap:anywhere}
.fx4-n,.nt4{font:italic 14.5px/1.5 var(--serif);color:var(--mu);margin:10px 0 2px;padding-left:12px;border-left:3px solid var(--ln)}
.ic4{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));gap:12px;margin:8px 0}
.ic4.tiles{grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr))}
.ic4-c{background:var(--card);border:1px solid var(--ln);border-top:4px solid var(--pc);border-radius:14px;padding:14px;min-width:0}
.ic4-i{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;background:color-mix(in srgb,var(--pc) 14%,var(--card));color:var(--pk);font:800 16px var(--sans);margin-bottom:6px}
.ic4.num .ic4-i{background:var(--pc);color:#fff}
.ic4-c b{display:block;font:800 15px/1.3 var(--sans);margin-bottom:4px}
.ic4-c p{margin:0;font:14px/1.45 var(--sans);color:var(--mu);overflow-wrap:break-word}
.it4{display:grid;gap:0;border:1px solid var(--ln);border-radius:14px;overflow:hidden;margin:8px 0;background:var(--card)}
.it4-r{display:grid;grid-template-columns:minmax(110px,.6fr) repeat(calc(var(--n) - 1),minmax(0,1fr));border-top:1px solid var(--ln)}
.it4-r:first-child{border-top:0}
.it4-r>span{padding:10px 12px;font:14px/1.45 var(--sans);min-width:0;overflow-wrap:break-word}
.it4-r>span:first-child{font-weight:800;color:var(--pk);background:color-mix(in srgb,var(--pc) 6%,var(--card))}
.it4-h>span{font:800 12px/1.3 var(--sans)!important;text-transform:uppercase;letter-spacing:.06em;color:#fff!important;background:var(--pc)!important}
.ch4{list-style:none;margin:8px 0;padding:0;display:flex;flex-wrap:wrap;gap:10px;counter-reset:c4}
.ch4>li{flex:1 1 170px;position:relative;background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:12px 14px 12px 44px;min-width:0;counter-increment:c4}
.ch4>li::before{content:counter(c4);position:absolute;left:12px;top:12px;width:24px;height:24px;border-radius:50%;background:var(--pc);color:#fff;font:800 13px/24px var(--sans);text-align:center}
.ch4>li b{display:block;font:800 15px/1.3 var(--sans)}.ch4>li span{display:block;font:14px/1.45 var(--sans);color:var(--mu);margin-top:3px}
.ch4.row>li{flex:1 1 120px;padding:12px 10px 12px 40px}
.vs4{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:stretch;margin:8px 0}
.vs4>div{min-width:0}
.vs4-a,.vs4-b{background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:14px}
.vs4-a{border-top:4px solid var(--pc)}.vs4-b{border-top:4px solid #868e96}
.vs4 b{display:block;font:800 15px var(--sans);margin-bottom:4px}.vs4 p{margin:0;font:14px/1.45 var(--sans)}
.vs4-m{align-self:center;font:800 18px var(--sans);color:var(--pk)}
.k4{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:8px 0}
.k4>div{background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:12px 14px;min-width:0}
.k4 b{display:block;font:italic 700 16px var(--serif);color:var(--pk)}.k4 span{font:14px/1.45 var(--sans)}
.nest4{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:8px 0}
.nest4-o{flex:1 1 260px;border:3px solid var(--pc);border-radius:18px;padding:12px 14px;background:color-mix(in srgb,var(--pc) 5%,var(--card))}
.nest4-o>b{font:800 15px var(--sans)}
.nest4-i{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}.nest4-i span{border:1px dashed var(--pc);border-radius:10px;padding:6px 10px;font:14px var(--sans);background:var(--card)}
.nest4-r{flex:0 1 220px;font:800 15px var(--sans);color:var(--pk)}
.hub4{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:8px 0}
.hub4-c{flex:none;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:var(--pc);color:#fff;font:800 22px var(--serif)}
.hub4-s{flex:1 1 240px;display:flex;flex-direction:column;gap:8px}.hub4-s span{background:var(--card);border:1px solid var(--ln);border-left:4px solid var(--pc);border-radius:10px;padding:8px 12px;font:14.5px var(--sans)}
.sub4{list-style:none;margin:8px 0;padding:0;display:grid;gap:8px}
.sub4 li{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center}
.sub4 span{background:var(--card);border:1px solid var(--ln);border-radius:10px;padding:8px 12px;font:14.5px var(--sans);min-width:0}
.sub4 b{color:#c2255c;font-size:22px}
.ax4{margin:6px 0 12px;padding:16px 18px;border-radius:14px;background:color-mix(in srgb,var(--pc) 8%,var(--card));border-left:5px solid var(--pc);font:italic 1.08rem/1.5 var(--serif)}
.ax4 p{margin:0}
@media (max-width:640px){
 .it4-h{display:none}
 .it4-r{grid-template-columns:1fr}
 .it4-r>span[data-h]::before{content:attr(data-h);display:block;font:800 11px var(--sans);text-transform:uppercase;letter-spacing:.06em;color:var(--mu);margin-bottom:2px}
 .vs4{grid-template-columns:1fr}.vs4-m{justify-self:center}
 .k4{grid-template-columns:1fr}
 .sub4 li{grid-template-columns:1fr;gap:4px}.sub4 b{justify-self:center;transform:rotate(90deg)}
 [data-anchor]{padding-left:10px}
 .figrefs{white-space:normal}
}
@media print{.figref{border:0;background:none}}
.desi-m{display:none;list-style:none;margin:8px 0;padding:0}
@media (max-width:640px){
 .chart-desi{display:none}
 .desi-m{display:grid;gap:14px}
 .desi-m li{display:grid;grid-template-columns:1fr auto;gap:4px 10px;align-items:center}
 .dm-l{grid-column:1/-1;font:700 14px var(--sans)}
 .dm-t{position:relative;height:18px;background:linear-gradient(90deg,var(--ln) 1px,transparent 1px) 0 0/20% 100%;border-bottom:1px solid var(--ln)}
 .dm-z{position:absolute;left:20%;top:-2px;bottom:-2px;border-left:2px dashed var(--tx)}
 .dm-e{position:absolute;top:8px;height:3px;background:var(--tx);border-radius:2px}
 .dm-p{position:absolute;top:3px;width:13px;height:13px;margin-left:-6.5px;border-radius:50%;border:2px solid #fff}
 .dm-p.p0{background:#1c7ed6}.dm-p.p1{background:#0ca678}.dm-p.p2{background:#e8590c}
 .desi-m b{font:800 13.5px var(--sans);color:var(--pk);white-space:nowrap}
 .dm-tk{background:none;border:0;height:16px}.dm-tk em{position:absolute;transform:translateX(-50%);font:600 11.5px var(--sans);font-style:normal;color:var(--mu)}
 .dm-tk em:first-child{transform:none}.dm-tk em:last-child{transform:translateX(-100%)}
}
</style>
</head>
<body>
<a class="skip" href="#five">К содержанию</a>
<div id="progress" aria-hidden="true"><div id="progress-bar"></div></div>
<header class="topbar">
  <a class="brand" href="#top" title="На главную"><span class="brand-dot"></span><span class="brand-t">Теория всего и ничего</span><span class="brand-s">гл. 1 · канон 7.2</span></a>
  <nav class="menu" aria-label="Основное меню">
    <a href="#top" data-nav="top">Главная</a>
    <a href="#five" data-nav="five">Глава за 5 минут</a>
    <span class="menu-parts" aria-label="Разделы"><span class="mp-l">Разделы</span><a class="np" href="#part-I" style="--c:#e8590c" title="Раздел I · Паспорт понятия">I</a><a class="np" href="#part-II" style="--c:#0b7285" title="Раздел II · От различения к Следу">II</a><a class="np" href="#part-III" style="--c:#6741d9" title="Раздел III · Генеалогия">III</a><a class="np" href="#part-IV" style="--c:#c2255c" title="Раздел IV · Пять записей">IV</a><a class="np" href="#part-V" style="--c:#2b8a3e" title="Раздел V · Программа проверки">V</a></span>
    <a href="#part-final" data-nav="final">Финал</a>
