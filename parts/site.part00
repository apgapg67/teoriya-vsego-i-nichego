  </nav>
  <div class="tools">
    <button class="tb" id="btn-search" aria-label="Поиск" title="Поиск (Ctrl+K)"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
    <button class="tb hide-s" id="btn-font-dec" aria-label="Уменьшить шрифт" title="Уменьшить шрифт">A−</button>
    <button class="tb hide-s" id="btn-font-inc" aria-label="Увеличить шрифт" title="Увеличить шрифт">A+</button>
    <button class="tb" id="btn-theme" aria-label="Светлая или тёмная тема" title="Светлая / тёмная тема"><svg viewBox="0 0 24 24"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></svg></button>
    <button class="tb" id="btn-menu" aria-label="Меню и оглавление" title="Меню и оглавление"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  </div>
</header>

<section class="hero" id="top">
  <img class="hero-img" src="data:image/webp;base64," alt="Иллюстрация: зимняя ночная улица, снег под фонарём (сгенерированное изображение, не фотография)" decoding="async" fetchpriority="high" loading="eager">
  <div class="hero-shade"></div><div class="snowfall" aria-hidden="true"></div>
  <div class="hero-in">
    <p class="hero-book">Андрей Грузевич · «Теория всего и ничего»</p>
    <h1 class="hero-title">Глава 1. ГН:<br>неисчерпаемость определения</h1>
    <p class="hero-sub">Регулятивный эпистемический горизонт неисчерпанности</p>
    <p class="hero-badge"><span>MASTER 7.2</span> канон, утверждён автором 9 октября 2026</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#part-prologue">Начать чтение</a>
      <a class="btn btn-glass" href="#five">Глава за 5 минут</a>
      <button class="btn btn-glass" id="btn-resume" hidden>Продолжить с места</button>
    </div>
